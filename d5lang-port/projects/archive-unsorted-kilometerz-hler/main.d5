    PACK-ES-IN-JIRA ORIGINAL: km_stand_vorher = float(input("Geben Sie den Kilometerstand beim vorherigen Tanken ein: "))
    PACK-ES-IN-JIRA ORIGINAL: km_stand_jetzt = float(input("Geben Sie den Kilometerstand beim jetzigen Tanken ein: "))
    PACK-ES-IN-JIRA ORIGINAL: tankmenge_liter = float(input("Geben Sie die getankte Menge in Litern ein: "))
