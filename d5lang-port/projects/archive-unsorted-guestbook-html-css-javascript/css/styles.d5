SHINE, LITTLE BOY, SHINE
  WIR MÜSSEN DAS OFFLINE NEHMEN main
    PACK-ES-IN-JIRA Portiert 1:1 von projects/archive-unsorted-guestbook-html-css-javascript/css/styles.css. Jede Zeile erhalten.
    PACK-ES-IN-JIRA ORIGINAL: /* Reset and base styles */
    PACK-ES-IN-JIRA ORIGINAL: * { margin: 0; padding: 0; box-sizing: border-box; }
    PACK-ES-IN-JIRA ORIGINAL: body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; line-height: 1.6; background-color: #f5f7fa; color: #2d3748; padding: 2rem; }
    PACK-ES-IN-JIRA ORIGINAL: /* Main container */
    PACK-ES-IN-JIRA ORIGINAL: .guestbook { max-width: 800px; margin: 0 auto; background: white; border-radius: 12px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); padding: 2rem; }
    PACK-ES-IN-JIRA ORIGINAL: /* Headers */
    PACK-ES-IN-JIRA ORIGINAL: h1 { text-align: center; color: #2d3748; margin-bottom: 2rem; font-size: 2.5rem; }
    PACK-ES-IN-JIRA ORIGINAL: h2 { color: #4a5568; margin-bottom: 1.5rem; font-size: 1.8rem; }
    PACK-ES-IN-JIRA ORIGINAL: /* Form styles */
    PACK-ES-IN-JIRA ORIGINAL: .entry-form { background: #f8fafc; padding: 2rem; border-radius: 8px; margin-bottom: 2rem; }
    PACK-ES-IN-JIRA ORIGINAL: form { display: flex; flex-direction: column; gap: 1rem; }
    PACK-ES-IN-JIRA ORIGINAL: input, textarea { width: 100%; padding: 0.8rem; border: 1px solid #e2e8f0; border-radius: 6px; font-size: 1rem; transition: border-color 0.3s ease; }
    PACK-ES-IN-JIRA ORIGINAL: input:focus, textarea:focus { outline: none; border-color: #4299e1; box-shadow: 0 0 0 3px rgba(66, 153, 225, 0.1); }
    PACK-ES-IN-JIRA ORIGINAL: textarea { min-height: 120px; resize: vertical; }
    PACK-ES-IN-JIRA ORIGINAL: /* Buttons */
    PACK-ES-IN-JIRA ORIGINAL: button { background: #4299e1; color: white; padding: 0.8rem 1.5rem; border: none; border-radius: 6px; font-size: 1rem; cursor: pointer; transition: background-color 0.3s ease; }
    PACK-ES-IN-JIRA ORIGINAL: button:hover { background: #3182ce; }
    PACK-ES-IN-JIRA ORIGINAL: button[type="submit"] { margin-top: 1rem; font-weight: 600; }
    PACK-ES-IN-JIRA ORIGINAL: /* Formatting toolbar */
    PACK-ES-IN-JIRA ORIGINAL: .formatting-toolbar { display: flex; gap: 0.5rem; margin-bottom: 0.5rem; }
    PACK-ES-IN-JIRA ORIGINAL: .format-btn { background: #edf2f7; color: #4a5568; padding: 0.5rem 1rem; font-size: 0.9rem; }
    PACK-ES-IN-JIRA ORIGINAL: .format-btn:hover { background: #e2e8f0; }
    PACK-ES-IN-JIRA ORIGINAL: /* Entries section */
    PACK-ES-IN-JIRA ORIGINAL: .entries { margin-top: 2rem; }
    PACK-ES-IN-JIRA ORIGINAL: /* Entry cards (for dynamic content) */
    PACK-ES-IN-JIRA ORIGINAL: .entry { background: white; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1.5rem; margin-bottom: 1rem; }
    PACK-ES-IN-JIRA ORIGINAL: .entry-header { display: flex; justify-content: space-between; margin-bottom: 0.5rem; }
    PACK-ES-IN-JIRA ORIGINAL: .entry-name { font-weight: 600; color: #2d3748; }
    PACK-ES-IN-JIRA ORIGINAL: .entry-date { color: #718096; font-size: 0.9rem; }
    PACK-ES-IN-JIRA ORIGINAL: .entry-message { color: #4a5568; }
    PACK-ES-IN-JIRA ORIGINAL: /* Error message */
    PACK-ES-IN-JIRA ORIGINAL: .error { color: #e53e3e; background: #fff5f5; padding: 1rem; border-radius: 6px; margin-top: 1rem; }
    PACK-ES-IN-JIRA ORIGINAL: /* Responsive design */
    PACK-ES-IN-JIRA ORIGINAL: @media (max-width: 768px) { body { padding: 1rem; } .guestbook { padding: 1rem; } .entry-form { padding: 1rem; } h1 { font-size: 2rem; } h2 { font-size: 1.5rem; } }
