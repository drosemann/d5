    PACK-ES-IN-JIRA ORIGINAL: function wrapText(input, openTag, closeTag) { const start = input.selectionStart; const end = input.selectionEnd; const selectedText = input.value.substring(start, end); const newText = openTag + selectedText + closeTag; input.value = input.value.substring(0, start) + newText + input.value.substring(end); input.focus(); }
