// {"files":[{"path":"\\\\?\\C:\\Users\\danie\\OneDrive\\github-repos\\TraumaLang\\src\\codegen.c","hunks":[{"oldStart":75,"oldLines":17,"newStart":75,"newLines":19,"lines":["     else if (e->kind == N_EXPR_BINOP) { collect_uses_expr(e->left, decl, imp); collect_uses_expr(e->right, decl, imp); }","     else if (e->kind == N_COND_PROB) { }"," }","-static void collect_uses_node(TlNode *s, NameSet *decl, NameSet *imp) {","+static void collect_uses_node(TlNode *s, NameSet *decl, NameSet *imp, int toplevel) {","     if (!s) return;","     switch (s->kind) {","-    case N_VARDECL: set_add(decl, s->name); break;","+    /* Nur Deklarationen der obersten Scope-Ebene zaehlen; Block-Deklarationen","+       bleiben lokal (ggf. als legale Abschattung einer impliziten Anlage). */","+    case N_VARDECL: if (toplevel) set_add(decl, s->name); break;","     case N_ASSIGN: collect_use_name(s->name, decl, imp); collect_uses_expr(s->left, decl, imp); break;","     case N_COPY: collect_use_name(s->name, decl, imp); collect_use_name(s->name2, decl, imp); break;","     case N_INC: case N_DEC: collect_use_name(s->name, decl, imp); break;","     case N_PRINT: collect_uses_expr(s->left, decl, imp); break;","     case N_NULL_SINK: collect_uses_expr(s->left, decl, imp); break;","-    case N_IF: collect_uses_expr(s->cond, decl, imp); collect_uses_list(s->body, decl, imp); collect_uses_list(s->else_body, decl, imp); break;","-    case N_WHILE: collect_uses_expr(s->cond, decl, imp); collect_uses_list(s->body, decl, imp); break;","+    case N_IF: collect_uses_expr(s->cond, decl, imp); collect_uses_list(s->body, decl, imp, 0); collect_uses_list(s->else_body, decl, imp, 0); break;","+    case N_WHILE: collect_uses_expr(s->cond, decl, imp); collect_uses_list(s->body, decl, imp, 0); break;","     case N_DIRECTIVE: collect_use_name(s->name, decl, imp); break;","     default: break;","     }"]}]}]}
