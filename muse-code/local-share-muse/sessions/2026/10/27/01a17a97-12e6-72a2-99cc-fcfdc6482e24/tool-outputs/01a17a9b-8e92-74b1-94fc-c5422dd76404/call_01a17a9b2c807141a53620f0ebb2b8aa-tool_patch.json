{"files":[{"path":"\\\\?\\C:\\Users\\danie\\OneDrive\\github-repos\\TraumaLang\\src\\runtime.c","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":89,"lines":["+#include <stdio.h>","+#include <stdlib.h>","+#include <string.h>","+#ifdef _WIN32","+#include <windows.h>","+#else","+#include <unistd.h>","+#include <time.h>","+#endif","+#include \"runtime.h\"","+","+static void tl_sleep_secs(int s) {","+#ifdef _WIN32","+    Sleep((DWORD)s * 1000);","+#else","+    sleep((unsigned)s);","+#endif","+}","+","+void tl_startup_banner(void) {","+    /* Verpflichtender Programmstart (Spez Kap. 13). Nur vom generierten main() aufgerufen. */","+    printf(\"LOADING DEPENDENCIES... CHECKING 340 ACCOUNTS FOR 240 EMPLOYEES... IT'S PROBABLY DNS...\\n\");","+    fflush(stdout);","+    tl_sleep_secs(8);","+}","+","+void tl_sync_wait(void) { tl_sleep_secs(8); } /* WE NEED TO SYNC */","+","+void tl_print_str(const char *s) { printf(\"%s\\n\", s ? s : \"(null)\"); }","+void tl_print_long(long v) { printf(\"%ld\\n\", v); }","+void tl_slack_str(const char *s) { printf(\"[SLACK] %s\\n\", s ? s : \"(null)\"); }","+void tl_slack_long(long v) { printf(\"[SLACK] %ld\\n\", v); }","+","+/* SEND IT TO DATADOG: Ausgabe + begrenzte SBOM-Allokation (64 KiB, sofort freigegeben). */","+void tl_datadog_str(const char *s) {","+    printf(\"%s\\n\", s ? s : \"(null)\");","+    /* Satire ohne Ressourcen-Erschoepfung: begrenzt, geprueft, freigegeben. */","+    char *buf = (char*)malloc(65536);","+    if (buf) { memset(buf, 0, 65536); /* SBOM-Puffer simuliert */ free(buf); }","+    printf(\"// sbom-entry simulated (bounded 64KiB)\\n\");","+}","+","+void tl_cloud_str(const char *s) {","+    printf(\"%s\\n\", s ? s : \"(null)\");","+    tl_sleep_secs(2); /* + $0.30 Satire, siehe Kommentar im generierten Code */","+}","+","+void tl_grafana_str(const char *s) {","+    if (tl_prob(50)) printf(\"%s\\n\", s ? s : \"(null)\");","+}","+","+void tl_escalate_str(const char *s) {","+    printf(\"%s\\n\", s ? s : \"(null)\");","+    tl_sleep_secs(8);","+}","+","+void tl_legacy_str(const char *s) {","+    printf(\"%s\\n\", s ? s : \"(null)\");","+    /* Kommentar ueber Legacy-Code steht im generierten C-Code. */","+}","+","+int tl_cab_open(void) {","+    /* Simulierte CAB-Zeitbedingung: deterministisch, keine echte Uhr-Abhaengigkeit. */","+    return tl_prob(50);","+}","+","+int tl_prob(int percent) {","+    if (percent <= 0) return 0;","+    if (percent >= 100) return 1;","+    return (rand() % 100) < percent;","+}","+","+void tl_chaos(void) { (void)tl_prob(50); }","+","+void tl_leak_once(void) {","+    /* WE RESERVED INSTANCES...: begrenzte, dokumentierte Allokation (4 KiB, wird NICHT freigegeben = Satire). */","+    static int done = 0;","+    if (done) return;","+    done = 1;","+    char *p = (char*)malloc(4096);","+    if (p) memset(p, 0xA5, 4096);","+    (void)p; /* absichtlich nicht freigegeben, aber strikt begrenzt */","+}","+","+void tl_governance_wrap(void (*f)(void)) { if (f) f(); }","+","+static long g_metrics = 0;","+long tl_metrics_counter(void) { return g_metrics; }","+void tl_metrics_inc(void) { g_metrics++; }"]}]}]}