// {"files":[{"path":"\\\\?\\C:\\Users\\danie\\OneDrive\\github-repos\\TraumaLang\\src\\codegen.c","hunks":[{"oldStart":275,"oldLines":17,"newStart":275,"newLines":33,"lines":["     }"," }"," ","+/* Ein Funktionsaufruf auf oberster Ebene (kein Block): fuer den Auto-Call von main. */","+static int body_has_func(TlNodeList *l, const char *name) {","+    for (; l; l = l->next)","+        if (l->node->kind == N_FUNCDEF && l->node->name && !strcmp(l->node->name, name)) return 1;","+    return 0;","+}","+"," int tl_codegen(TlNode *prog, FILE *out, char **err_out) {","     char *err = NULL;","     fprintf(out, \"/* Generiert aus TraumaLang. Startup-Banner + 8s Delay sind verpflichtend. */\\n\");","     fprintf(out, \"#include <stdio.h>\\n#include <stdlib.h>\\n#include <string.h>\\n\");","     fprintf(out, \"#include \\\"runtime.h\\\"\\n\\n\");","-    /* Vorab-Deklarationen: alle Variablen als long + String-Support via Zeiger ist bewusst einfach gehalten:","-       jede Variable wird als long angelegt; String-Zuweisungen nutzen einen separaten const char*-Slot. */","-    fprintf(out, \"int main(void) {\\n\");","+    /* Pass 1: Funktionen gehoistet vor main() (tlf_-Praefix, kein Clash mit echtem main). */","+    TlNodeList *l;","+    for (l = prog->body; l; l = l->next)","+        if (l->node->kind == N_FUNCDEF)","+            if (gen_stmt(l->node, out, 0, &err)) { if (err_out) *err_out = err; return -1; }","+    fprintf(out, \"\\nint main(void) {\\n\");","     fprintf(out, \"    srand(1337);\\n\");","     fprintf(out, \"    tl_startup_banner();\\n\");","-    if (gen_body(prog->body, out, 1, &err)) { if (err_out) *err_out = err; return -1; }","+    emit_implicits(prog->body, out, 1);","+    /* Pass 2: Anweisungen der obersten Ebene (Funktionsdefinitionen ueberspringen). */","+    for (l = prog->body; l; l = l->next) {","+        if (l->node->kind == N_FUNCDEF) continue;","+        if (gen_stmt(l->node, out, 1, &err)) { if (err_out) *err_out = err; return -1; }","+    }","+    if (body_has_func(prog->body, \"main\")) fprintf(out, \"    tlf_main();\\n\");","     fprintf(out, \"    return 0;\\n}\\n\");","     return 0;"," }"]}]}]}
