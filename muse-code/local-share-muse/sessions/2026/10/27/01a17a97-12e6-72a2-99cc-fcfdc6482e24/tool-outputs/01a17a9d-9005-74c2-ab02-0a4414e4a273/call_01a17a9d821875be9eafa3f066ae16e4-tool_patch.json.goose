// {"files":[{"path":"\\\\?\\C:\\Users\\danie\\OneDrive\\github-repos\\TraumaLang\\tests\\parser_tests.c","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":42,"lines":["+#include <assert.h>","+#include <stdio.h>","+#include <string.h>","+#include <stdlib.h>","+#include \"../src/lexer.h\"","+#include \"../src/parser.h\"","+#include \"../src/ast.h\"","+","+static TlNode *parse_src(const char *src) {","+    TlTokVec v; tl_tokens_init(&v);","+    if (tl_lex(src, \"t\", &v)) { tl_tokens_free(&v); return NULL; }","+    char *err = NULL; int el = 0;","+    TlNode *p = tl_parse(&v, &err, &el);","+    free(err); tl_tokens_free(&v);","+    return p;","+}","+","+/* Parser/AST: Programmgeruest, Variablen, if/else, while+break/continue, Funktionen, Fehler mit Zeile. */","+int main(void) {","+    TlNode *p = parse_src(\"IT'S SHOWTIME\\nYOU HAVE BEEN TERMINATED\\n\");","+    assert(p && p->kind == N_PROGRAM); tl_node_free(p);","+","+    p = parse_src(\"IT'S SHOWTIME\\nWE HAVE 240 EMPLOYEES AND 340 ACTIVE ACCOUNTS x\\nYOU HAVE BEEN TERMINATED\\n\");","+    assert(p); tl_node_free(p);","+","+    p = parse_src(\"IT'S SHOWTIME\\nDO IT FOR THE METRICS x\\nTALK TO THE HAND \\\"a\\\"\\nBLUE IS BROKEN GREEN IS WORSE\\nTALK TO THE HAND \\\"b\\\"\\nYOU HAVE BEEN TERMINATED\\nYOU HAVE BEEN TERMINATED\\n\");","+    assert(p); tl_node_free(p);","+","+    p = parse_src(\"IT'S SHOWTIME\\nSTICK AROUND UNTIL THE SPRINT ENDS x\\nCONSIDER THAT A DIVORCE\\nLET'S CIRCLE BACK LATER\\nYOU HAVE BEEN TERMINATED\\nYOU HAVE BEEN TERMINATED\\n\");","+    assert(p); tl_node_free(p);","+","+    p = parse_src(\"IT'S SHOWTIME\\nWE NEED TO TAKE THIS OFFLINE f\\nTALK TO THE HAND \\\"x\\\"\\nTHIS COULD HAVE BEEN AN EMAIL\\nYOU HAVE BEEN TERMINATED\\n\");","+    assert(p); tl_node_free(p);","+","+    /* Fehlerfaelle: fehlendes TERMINATED, falscher Blockabschluss */","+    p = parse_src(\"IT'S SHOWTIME\\nTALK TO THE HAND \\\"x\\\"\\n\");","+    assert(!p);","+    p = parse_src(\"TALK TO THE HAND \\\"x\\\"\\nYOU HAVE BEEN TERMINATED\\n\");","+    assert(!p);","+","+    printf(\"parser ok\\n\"); return 0;","+}"]}]}]}
