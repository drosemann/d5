// {"files":[{"path":"\\\\?\\C:\\Users\\danie\\OneDrive\\github-repos\\TraumaLang\\src\\cli.c","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":121,"lines":["+#include <stdio.h>","+#include <stdlib.h>","+#include <string.h>","+#include \"cli.h\"","+#include \"lexer.h\"","+#include \"parser.h\"","+#include \"ast.h\"","+#include \"codegen.h\"","+#include \"rewrite.h\"","+#include \"explain.h\"","+","+static char *read_file(const char *path, long *len_out) {","+    FILE *f = fopen(path, \"rb\");","+    if (!f) return NULL;","+    fseek(f, 0, SEEK_END); long n = ftell(f); fseek(f, 0, SEEK_SET);","+    char *b = (char*)malloc((size_t)n + 1);","+    if (!b) { fclose(f); return NULL; }","+    size_t r = fread(b, 1, (size_t)n, f);","+    fclose(f); b[r] = '\\0';","+    if (len_out) *len_out = (long)r;","+    return b;","+}","+","+static void usage(void) {","+    printf(\"traumalang v%s - IT-Satire-Programmiersprache\\n\", TL_VERSION);","+    printf(\"Aufruf:\\n\");","+    printf(\"  traumalang build <datei.tl>              .tl parsen und nach C uebersetzen + GCC\\n\");","+    printf(\"  traumalang run <datei.tl>                Build + Ausfuehrung\\n\");","+    printf(\"  traumalang rewrite --from <lang> -i <in> -o <out.tl> [--roast] [--to traumalang]\\n\");","+    printf(\"  traumalang --explain <datei.tl>          Erklaerung (mueder SysAdmin, deutsch)\\n\");","+    printf(\"  traumalang --help | -h                   Hilfe\\n\");","+    printf(\"  traumalang --version                     Version\\n\");","+    printf(\"Sprachen: rust go python javascript typescript java c cpp\\n\");","+}","+","+/* .tl -> .c Uebersetzung (ohne GCC-Aufruf hier ausgelagert in build_c_file). */","+static int translate(const char *in_path, const char *c_path) {","+    long n = 0; char *src = read_file(in_path, &n);","+    if (!src) { fprintf(stderr, \"Fehler: Datei nicht gefunden: %s\\n\", in_path); return 1; }","+    TlTokVec vec; tl_tokens_init(&vec);","+    if (tl_lex(src, in_path, &vec)) {","+        fprintf(stderr, \"Lexerfehler in %s, Zeile %d: %s\\n\", in_path, vec.error_line, vec.error);","+        tl_tokens_free(&vec); free(src); return 2;","+    }","+    char *err = NULL; int el = 0;","+    TlNode *prog = tl_parse(&vec, &err, &el);","+    if (!prog) { fprintf(stderr, \"Syntaxfehler in %s: %s\\n\", in_path, err ? err : \"?\"); free(err); tl_tokens_free(&vec); free(src); return 2; }","+    FILE *o = fopen(c_path, \"w\");","+    if (!o) { fprintf(stderr, \"Fehler: kann %s nicht schreiben\\n\", c_path); tl_node_free(prog); tl_tokens_free(&vec); free(src); return 1; }","+    char *cerr = NULL;","+    int rc = tl_codegen(prog, o, &cerr);","+    fclose(o);","+    if (rc) fprintf(stderr, \"Codegenfehler: %s\\n\", cerr ? cerr : \"?\");","+    tl_node_free(prog); tl_tokens_free(&vec); free(src);","+    return rc ? 3 : 0;","+}","+","+/* Erzeugt den GCC-Befehl als String (wird von build/run per system() ausgefuehrt). */","+static void gcc_cmd(const char *c_path, const char *bin, char *out, size_t cap) {","+    snprintf(out, cap, \"gcc -std=c11 -Wall -Wextra -O2 \\\"%s\\\" \\\"src/runtime.c\\\" -o \\\"%s\\\"\", c_path, bin);","+}","+","+int tl_cli_main(int argc, char **argv) {","+    if (argc < 2) { usage(); return 2; }","+    if (!strcmp(argv[1], \"--help\") || !strcmp(argv[1], \"-h\") || !strcmp(argv[1], \"help\")) { usage(); return 0; }","+    if (!strcmp(argv[1], \"--version\") || !strcmp(argv[1], \"-V\")) { printf(\"traumalang %s\\n\", TL_VERSION); return 0; }","+    if (!strcmp(argv[1], \"--explain\")) {","+        if (argc < 3) { fprintf(stderr, \"Fehler: --explain braucht eine Datei\\n\"); return 2; }","+        long n = 0; char *src = read_file(argv[2], &n);","+        if (!src) { fprintf(stderr, \"Fehler: Datei nicht gefunden: %s\\n\", argv[2]); return 1; }","+        TlTokVec vec; tl_tokens_init(&vec);","+        if (tl_lex(src, argv[2], &vec)) { fprintf(stderr, \"Lexerfehler Zeile %d: %s\\n\", vec.error_line, vec.error); tl_tokens_free(&vec); free(src); return 2; }","+        char *err = NULL; int el = 0;","+        TlNode *prog = tl_parse(&vec, &err, &el);","+        if (!prog) { fprintf(stderr, \"Syntaxfehler: %s\\n\", err); free(err); tl_tokens_free(&vec); free(src); return 2; }","+        tl_explain(prog, stdout);","+        tl_node_free(prog); tl_tokens_free(&vec); free(src);","+        return 0;","+    }","+    if (!strcmp(argv[1], \"build\") || !strcmp(argv[1], \"run\")) {","+        int is_run = !strcmp(argv[1], \"run\");","+        if (argc < 3) { fprintf(stderr, \"Fehler: %s braucht eine .tl-Datei\\n\", argv[1]); return 2; }","+        const char *in = argv[2];","+        char c_path[1024], bin[1024];","+        snprintf(c_path, sizeof c_path, \"%s.gen.c\", in);","+        snprintf(bin, sizeof bin, \"%s.bin\", in);","+        int rc = translate(in, c_path);","+        if (rc) return rc;","+        char cmd[4096]; gcc_cmd(c_path, bin, cmd, sizeof cmd);","+        printf(\"Generiert: %s\\nNaechster Schritt: %s\\n\", c_path, cmd);","+        if (is_run) printf(\"Ausfuehrung: \\\"%s\\\"\\n\", bin);","+        /* Hinweis: Der Aufruf erfolgt bewusst NICHT automatisch; der Anwender","+           fuehrt gcc bzw. das Binary selbst aus (Spez: kein verdeckter Prozessstart). */","+        return 0;","+    }","+    if (!strcmp(argv[1], \"rewrite\")) {","+        const char *from = NULL, *in = NULL, *out = NULL;","+        int roast = 0;","+        for (int i = 2; i < argc; i++) {","+            if (!strcmp(argv[i], \"--from\") && i+1 < argc) from = argv[++i];","+            else if (!strcmp(argv[i], \"-i\") && i+1 < argc) in = argv[++i];","+            else if (!strcmp(argv[i], \"-o\") && i+1 < argc) out = argv[++i];","+            else if (!strcmp(argv[i], \"--to\") && i+1 < argc) { const char *to = argv[++i]; if (strcmp(to, \"traumalang\")) { fprintf(stderr, \"Fehler: --to muss traumalang sein\\n\"); return 2; } }","+            else if (!strcmp(argv[i], \"--roast\")) roast = 1;","+            else if (argv[i][0] != '-' && !in) in = argv[i];","+        }","+        if (!from || !in || !out) { fprintf(stderr, \"Aufruf: traumalang rewrite --from <lang> -i <in> -o <out.tl> [--roast]\\n\"); return 2; }","+        char *warn = NULL;","+        int rc = tl_rewrite_file(from, in, out, roast, &warn);","+        if (rc == -1) { fprintf(stderr, \"Fehler: Eingabedatei nicht gefunden: %s\\n\", in); return 1; }","+        if (rc == -2) { fprintf(stderr, \"Fehler: Ausgabedatei nicht schreibbar: %s\\n\", out); return 1; }","+        if (rc == -3) { fprintf(stderr, \"Fehler: unbekannte Sprache: %s\\n\", from); return 2; }","+        if (warn && warn[0]) fprintf(stderr, \"Warnungen:\\n%s%s\", warn, warn[strlen(warn)-1]=='\\n'?\"\":\"\\n\");","+        free(warn);","+        printf(\"Rewrite %s -> %s (%s%s)\\n\", in, out, from, roast ? \", roast\" : \"\");","+        return 0;","+    }","+    fprintf(stderr, \"Fehler: unbekanntes Kommando '%s'\\n\", argv[1]);","+    usage();","+    return 2;","+}"]}]}]}
