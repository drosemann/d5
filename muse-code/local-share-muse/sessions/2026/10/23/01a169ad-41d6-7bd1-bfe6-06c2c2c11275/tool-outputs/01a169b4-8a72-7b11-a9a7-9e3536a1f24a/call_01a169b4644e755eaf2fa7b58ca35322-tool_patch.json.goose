               onFocus={() => {if (mode !== 'COMMAND') setMode('COMMAND');}}","-                  onBlur={() => {if (mode === 'COMMAND') setMode('NORMAL');}}","-                  onChange={event => setCommand(event.target.value)}","-                  onKeyDown={event => {if (event.key === 'Escape') {setCommand(''); setMode('NORMAL'); editorRef.current?.focus();}}}","-                  placeholder=\"Type a command — try help\"","-                  autoComplete=\"off\"","-                  spellCheck={false}","-                />","-                <span className=\"command-hint\">Enter to run <kbd>Esc</kbd></span>","-              </form>","-              <div className={`status-line ${status.startsWith('?') ? 'status-error' : ''}`} role=\"status\">","-                <span className=\"status-prompt\">{status.startsWith('?') ? '?' : '●'}</span>","-                <span>{status.replace(/^\\?\\s?/, '')}</span>","-                <span className=\"status-shortcuts\">i insert <b>·</b> : command <b>·</b> Esc normal</span>","-              </div>","-            </>","-          ) : (","-            <div className=\"welcome\">","-              <div className=\"welcome-card\">","-                <div className=\"welcome-symbol\">e<span>.</span></div>","-                <p className=\"eyebrow\">A QUIETER KIND OF DOCUMENT</p>","-                <h2>Just you and the page.</h2>","-                <p className=\"welcome-copy\">Write in Markdown. Work offline. Save when you mean it. Your documents stay in this browser unless you export them.</p>","-                <button className=\"button button-primary welcome-button\" onClick={() => makeDocument()}>","-                  <span aria-hidden=\"true\">+</span> Create your first document","-                </button>","-                <div className=\"welcome-prompt\"><kbd>i</kbd> to insert <span>·</span> <kbd>Esc</kbd> to stop <span>·</span> <kbd>:w</kbd> to write</div>","-              </div>","-            </div>","-          )}","-        </section>","-      </div>","-      <footer className=\"app-footer\">","-        <span>ed-docs <span className=\"footer-divider\">·</span> offline-first, intentionally small</span>","-        <span>{offlineError ? 'Offline cache unavailable' : offlineReady ? 'App shell cached for offline use' : 'Offline cache initializing'}</span>","-      </footer>","-    </main>","-  );","-}","-","-createRoot(document.getElementById('root')!).render(","-  <React.StrictMode>","-    <App />","-  </React.StrictMode>,","-);","+import React, {useEffect, useMemo, useRef, useState} from 'react';","+import {createRoot} from 'react-dom/client';","+import './styles.css';","+import type {DocumentRecord, EditorMode} from './editor/types';","+import {createUndoStack, type RepeatAction} from './editor/history';","+import {","+  caretToLineCol, lineOffsets, nextWordStart, prevWordStart, wordEnd,","+} from './editor/motions';","+import {applySubstitute, dispatchCommand, type PendingConfirm} from './editor/commands';","+import {","+  clearLibrary, createDocument, pushSnapshot, pushTape, readAch, readGolf, readLibrary,","+  readSettings, readSnapshots, readTape, writeAch, writeGolf, writeLibrary, writeSettings,","+  type Settings,","+} from './lib/storage';","+import {clerkEmpty, clerkError, clerkQuitDirty, clerkWrite} from './lib/clerk';","+import {kaChunk, softTick} from './lib/sound';","+import {golfScore, golfVerdict} from './lib/golf';","+import {ACHIEVEMENTS, checkAchievements} from './lib/achievements';","+import {docStats, renderMarkdown} from './lib/markdown';","+","+type Overlay = null | 'help' | 'tape' | 'achievements' | 'snapshots' | 'preview-help';","+","+function sanitizeFilename(name: string): string {","+  return (name.trim() || 'untitled').replace(/[<>:\"/\\\\|?*\\x00-\\x1f]/g, '-');","+}","+","+function App() {","+  const [initialLibrary] = useState(readLibrary);","+  const [initialSettings] = useState(readSettings);","+  const [libraryReadError, setLibraryReadError] = useState(initialLibrary.error);","+  const [documents, setDocuments] = useState(initialLibrary.documents);","+  const [settings, setSettings] = useState<Settings>(initialSettings);","+  const [activeId, setActiveId] = useState<string | null>(null);","+  const [draftTitle, setDraftTitle] = useState('');","+  const [draft, setDraft] = useState('');","+  const [mode, setMode] = useState<EditorMode>('NORMAL');","+  const [command, setCommand] = useState('');","+  const [status, setStatus] = useState(initialLibrary.error ? `? ${initialLibrary.error}` : 'Ready. Your documents stay in this browser.');","+  const [isOnline, setIsOnline] = useState(navigator.onLine);","+  const [offlineReady, setOfflineReady] = useState(false);","+  const [offlineError, setOfflineError] = useState<string | null>(null);","+  const [overlay, setOverlay] = useState<Overlay>(null);","+  const [tapeIndex, setTapeIndex] = useState(0);","+  const [tape, setTape] = useState<string[]>(() => readTape());","+  const [preview, setPreview] = useState(false);","+  const [writing, setWriting] = useState(false);","+  const [lastSearch, setLastSearch] = useState('');","+  const [confirm, setConfirm] = useState<PendingConfirm | null>(null);","+  const [confirmDraft, setConfirmDraft] = useState('');","+  const [pendingReplace, setPendingReplace] = useState(false);","+  const editorRef = useRef<HTMLTextAreaElement>(null);","+  const commandRef = useRef<HTMLInputElement>(null);","+  const importRef = useRef<HTMLInputElement>(null);","+  const undoRef = useRef(createUndoStack());","+  const registerRef = useRef<{unnamed: string}>({unnamed: ''});","+  const pendingOpRef = useRef<{op: 'd' | 'y' | 'g'; count: string} | null>(null);","+  const countRef = useRef('');","+  const lastRepeat = useRef<RepeatAction>(null);","+  const keysRef = useRef(0);","+  const cmdsRef = useRef(0);","+  const hjklStreak = useRef(0);","+  const achRef = useRef(readAch());","+  const gcConfirms = useRef(0);","+  const golfBestRef = useRef(0);","+","+  const activeDocument = documents.find(document => document.id === activeId) ?? null;","+  const isDirty = activeDocument !== null &&","+    (draft !== activeDocument.content || draftTitle !== activeDocument.title);","+  const stats = useMemo(() => docStats(draft), [draft]);","+  const lineCount = draft.split('\\n').length;","+  const caretInfo = caretToLineCol(draft, editorRef.current?.selectionStart ?? 0);","+","+  useEffect(() => {","+    document.body.classList.toggle('gloom', settings.gloom);","+  }, [settings.gloom]);","+","+  useEffect(() => {","+    const updateOnline = () => setIsOnline(navigator.onLine);","+    window.addEventListener('online', updateOnline);","+    window.addEventListener('offline', updateOnline);","+    if ('serviceWorker' in navigator) {","+      navigator.serviceWorker.register('/sw.js')","+        .then(() => setOfflineReady(true))","+        .catch(error => setOfflineError(error instanceof Error ? error.message : String(error)));","+    } else {","+      setOfflineError('This browser does not support offline app caching.');","+    }","+    return () => {","+      window.removeEventListener('online', updateOnline);","+      window.removeEventListener('offline', updateOnline);","+    };","+  }, []);","+","+  useEffect(() => {","+    if (mode === 'COMMAND') commandRef.current?.focus();","+  }, [mode]);","+","+  const setFailure = (message: string) => setStatus(clerkError(message.startsWith('?') ? message : `? ${message}`, settings));","+","+  const updateSettings = (next: Settings) => {","+    setSettings(next);","+    writeSettings(next);","+  };","+","+  const awardCheck = (extra?: {golfBest?: number}) => {","+    const ach = achRef.current;","+    const fresh = checkAchievements({","+      unlocked: ach.unlocked,","+      colonCommands: ach.colonCommands,","+      xDeletes: ach.xDeletes,","+      mouseFreeStreak: ach.mouseFreeStreak,","+      gcConfirms: gcConfirms.current,","+      golfBest: extra?.golfBest ?? golfBestRef.current,","+      hour: new Date().getHours(),","+    });","+    if (fresh.length > 0) {","+      const titles = fresh.map(id => ACHIEVEMENTS.find(a => a.id === id)?.title ?? id).join(', ');","+      achRef.current = {...ach, unlocked: [...ach.unlocked, ...fresh]};","+      writeAch(achRef.current);","+      setStatus(prev => `${prev} ★ ${titles}`);","+    }","+  };","+","+  const persist = (next: DocumentRecord[]) => {","+    if (libraryReadError) {","+      setFailure('Local data could not be loaded; refusing to overwrite it.');","+      return false;","+    }","+    try {","+      if (!writeLibrary(next)) throw new Error('quota or permission');","+      setDocuments(next);","+      return true;","+    } catch (error) {","+      setFailure(`Could not write local documents: ${error instanceof Error ? error.message : String(error)}`);","+      return false;","+    }","+  };","+","+  const canLeaveEditor = (force = false) => {","+    if (force) return true;","+    if (!isDirty) return true;","+    if (window.confirm('Discard unsaved edits? Use :w to save them first.')) return true;","+    setStatus(clerkQuitDirty(settings));","+    return false;","+  };","+","+  const openDocument = (document: DocumentRecord) => {","+    if (!canLeaveEditor()) return;","+    undoRef.current.clear();","+    keysRef.current = 0;","+    cmdsRef.current = 0;","+    golfBestRef.current = readGolf(document.id).best;","+    setActiveId(document.id);","+    setDraftTitle(document.title);","+    setDraft(document.content);","+    setMode('NORMAL');","+    setConfirm(null);","+    setStatus(`Opened ${document.title}`);","+  };","+","+  const makeDocument = (title = 'Untitled document') => {","+    if (!canLeaveEditor()) return;","+    const document = createDocument(title);","+    if (!persist([...documents, document])) return;","+    undoRef.current.clear();","+    keysRef.current = 0;","+    cmdsRef.current = 0;","+    setActiveId(document.id);","+    setDraftTitle(document.title);","+    setDraft('');","+    setMode('NORMAL');","+    setStatus(`Created ${document.title}. Use :w to write changes.`);","+  };","+","+  const saveDocument = (filename?: string) => {","+    if (!activeDocument || !activeId) {","+      setFailure('No document is open.');","+      return false;","+    }","+    const title = draftTitle.trim() || 'Untitled document';","+    const saved: DocumentRecord = {...activeDocument, title, content: draft, updatedAt: new Date().toISOString()};","+    if (!persist(documents.map(document => document.id === saved.id ? saved : document))) return false;","+    setDraftTitle(title);","+    pushSnapshot(activeId, draft);","+    const keys = keysRef.current;","+    const cmds = cmdsRef.current;","+    const score = golfScore(draft.length, keys, cmds);","+    const prev = readGolf(activeId);","+    const best = Math.max(prev.best, score);","+    golfBestRef.current = best;","+    writeGolf(activeId, {keys, commands: cmds, best});","+    const golfBit = keys > 0 ? ` ⛳ ${score} (best ${best}). ${golfVerdict(score)}` : '';","+    if (draft.trim() === '') setStatus(clerkEmpty(settings));","+    else setStatus(`${clerkWrite(lineCount, settings)}${golfBit}`);","+    setWriting(true);","+    window.setTimeout(() => setWriting(false), 500);","+    if (settings.sound) kaChunk();","+    const hour = new Date().getHours();","+    if (hour === 0 || hour >= 22 || hour < 5) awardCheck({golfBest: best});","+    else awardCheck({golfBest: best});","+    if (filename) {","+      const blob = new Blob([draft], {type: 'text/markdown;charset=utf-8'});","+      const url = URL.createObjectURL(blob);","+      const link = window.document.createElement('a');","+      link.href = url;","+      link.download = `${sanitizeFilename(filename)}.md`;","+      link.click();","+      URL.revokeObjectURL(url);","+    }","+    return true;","+  };","+","+  useEffect(() => {","+    const handleSaveShortcut = (event: KeyboardEvent) => {","+      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 's') {","+        event.preventDefault();","+        saveDocument();","+      }","+    };","+    window.addEventListener('keydown', handleSaveShortcut);","+    return () => window.removeEventListener('keydown', handleSaveShortcut);","+     ","+  });","+","+  const closeDocument = (force = false) => {","+    if (!canLeaveEditor(force)) return;","+    setActiveId(null);","+    setMode('NORMAL');","+    setConfirm(null);","+    setOverlay(null);","+    setStatus('Back to the library.');","+  };","+","+  const exportDocument = () => {","+    if (!activeDocument) return;","+    const safeName = sanitizeFilename(draftTitle);","+    const blob = new Blob([draft], {type: 'text/markdown;charset=utf-8'});","+    const url = URL.createObjectURL(blob);","+    const link = window.document.createElement('a');","+    link.href = url;","+    link.download = `${safeName}.md`;","+    link.click();","+    URL.revokeObjectURL(url);","+    setStatus(`Exported ${safeName}.md`);","+  };","+","+  const currentLineRange = () => {","+    const text = draft;","+    const caret = editorRef.current?.selectionStart ?? 0;","+    const start = text.lastIndexOf('\\n', caret - 1) + 1;","+    const nextBreak = text.indexOf('\\n', caret);","+    return {start, end: nextBreak === -1 ? text.length : nextBreak, caret};","+  };","+","+  const focusEditor = (caret?: number | null) => {","+    requestAnimationFrame(() => {","+      const editor = editorRef.current;","+      if (!editor) return;","+      editor.focus();","+      if (caret !== undefined && caret !== null) {","+        const atEnd = caret >= draft.length && draft.length > 0;","+        editor.setSelectionRange(atEnd ? caret : caret, atEnd ? caret : Math.min(caret + 1, draft.length));","+        if (!atEnd) {","+          window.setTimeout(() => {","+            if (document.activeElement === editor) editor.setSelectionRange(caret, caret);","+          }, 60);","+        }","+      }","+    });","+  };","+","+  const pushUndo = (caret?: number) => {","+    undoRef.current.push({draft, caret: caret ?? editorRef.current?.selectionStart ?? 0});","+  };","+","+  const insertMode = (append: boolean) => {","+    const editor = editorRef.current;","+    if (append && editor) editor.setSelectionRange(currentLineRange().end, currentLineRange().end);","+    setMode('INSERT');","+    setStatus('INSERT — press Esc to return to normal mode.');","+    requestAnimationFrame(() => editorRef.current?.focus());","+  };","+","+  const moveCursor = (direction: 'left' | 'right' | 'up' | 'down' | 'start' | 'end') => {","+    const editor = editorRef.current;","+    if (!editor) return;","+    const text = draft;","+    const caret = editor.selectionStart;","+    const {start, end} = currentLineRange();","+    let next = caret;","+    if (direction === 'left') next = Math.max(0, caret - 1);","+    if (direction === 'right') next = Math.min(text.length, caret + 1);","+    if (direction === 'start') next = start;","+    if (direction === 'end') next = end;","+    if (direction === 'up' || direction === 'down') {","+      const lines = text.split('\\n');","+      const currentLine = text.slice(0, caret).split('\\n').length - 1;","+      const column = caret - start;","+      const targetLine = Math.max(0, Math.min(lines.length - 1, currentLine + (direction === 'up' ? -1 : 1)));","+      const targetStart = lines.slice(0, targetLine).reduce((length, line) => length + line.length + 1, 0);","+      next = targetStart + Math.min(column, lines[targetLine].length);","+    }","+    editor.setSelectionRange(next, next);","+  };","+","+  const deleteCurrentLine = (count = 1) => {","+    const text = draft;","+    const caret = editorRef.current?.selectionStart ?? 0;","+    const firstLine = text.slice(0, caret).split('\\n').length - 1;","+    const offsets = lineOffsets(text);","+    const last = offsets.length - 1;","+    const fromLine = Math.max(0, Math.min(firstLine, last));","+    const toLine = Math.max(fromLine, Math.min(firstLine + count - 1, last));","+    const from = offsets[fromLine];","+    let to = toLine === last ? text.length : offsets[toLine + 1] - 1;","+    let f = from;","+    if (to < text.length) to += 1;","+    else if (f > 0) f -= 1;","+    pushUndo(caret);","+    registerRef.current.unnamed = text.slice(from, toLine === last ? text.length : offsets[toLine + 1] - 1);","+    const next = text.slice(0, f) + text.slice(to);","+    setDraft(next || '');","+    focusEditor(Math.min(f, next.length));","+    setStatus(`${toLine - fromLine + 1} line(s) deleted.`);","+  };","+","+  const yankLine = (count = 1) => {","+    const text = draft;","+    const caret = editorRef.current?.selectionStart ?? 0;","+    const firstLine = text.slice(0, caret).split('\\n').length - 1;","+    const offsets = lineOffsets(text);","+    const last = offsets.length - 1;","+    const toLine = Math.min(firstLine + count - 1, last);","+    registerRef.current.unnamed = text.slice(offsets[firstLine], toLine === last ? text.length : offsets[toLine + 1] - 1);","+    setStatus(`${toLine - firstLine + 1} line(s) yanked.`);","+  };","+","+  const pasteRegister = (before: boolean) => {","+    const clip = registerRef.current.unnamed;","+    if (!clip) {","+      setFailure('Register is empty. Yank something first.');","+      return;","+    }","+    const editor = editorRef.current;","+    const caret = editor?.selectionStart ?? 0;","+    pushUndo(caret);","+    if (before) {","+      const start = currentLineRange().start;","+      const next = `${draft.slice(0, start)}${clip}\\n${draft.slice(start)}`;","+      setDraft(next);","+      focusEditor(start);","+    } else {","+      const {end} = currentLineRange();","+      const next = `${draft.slice(0, end)}\\n${clip}${draft.slice(end)}`;","+      setDraft(next);","+      focusEditor(end + 1);","+    }","+    setStatus('Pasted.');","+  };","+","+  const runCommand = (rawCommand: string) => {","+    const trimmed = rawCommand.trim();","+    if (trimmed === '') {","+      setMode('NORMAL');","+      return;","+    }","+    if (trimmed === 'q:') {","+      setTape(readTape());","+      setTapeIndex(Math.max(0, readTape().length - 1));","+      setOverlay('tape');","+      setMode('NORMAL');","+      setCommand('');","+      return;","+    }","+    const editor = editorRef.current;","+    const caret = editor?.selectionStart ?? 0;","+    const ctx = {","+      draft,","+      caret,","+      draftTitle,","+      lastSearch,","+      setLastSearch: (p: string) => setLastSearch(p),","+      pushUndo: (entry: {draft: string; caret: number}) => undoRef.current.push(entry),","+    };","+    const result = dispatchCommand(trimmed, ctx, {","+      save: (filename?: string) => {","+        const ok = saveDocument(filename);","+        return {ok, status: ok ? status : status, filename};","+      },","+      close: (force: boolean) => {","+        if (!force && isDirty) {","+          setStatus(clerkQuitDirty(settings));","+          return {ok: false, status: 'dirty'};","+        }","+        setActiveId(null);","+        setMode('NORMAL');","+        setOverlay(null);","+        setStatus(force && isDirty ? 'Quit without saving. The clerk saw nothing.' : 'Back to the library.');","+        return {ok: true, status: 'closed'};","+      },","+      openByTitle: (title: string, force: boolean) => {","+        const target = documents.find(document =>","+          document.title.toLocaleLowerCase() === title.toLocaleLowerCase()","+        );","+        if (!target) return {ok: false, status: `? No document titled \"${title}\".`};","+        if (!force && isDirty && !window.confirm('Discard unsaved edits?')) {","+          return {ok: false, status: clerkQuitDirty(settings)};","+        }","+        undoRef.current.clear();","+        setActiveId(target.id);","+        setDraftTitle(target.title);","+        setDraft(target.content);","+        setMode('NORMAL');","+        return {ok: true, status: `Opened ${target.title}`};","+      },","+      makeDoc: (title: string) => {","+        if (isDirty && !window.confirm('Discard unsaved edits?')) {","+          return {ok: false, status: clerkQuitDirty(settings)};","+        }","+        const document = createDocument(title);","+        const next = [...documents, document];","+        if (!writeLibrary(next)) return {ok: false, status: '? Could not write local documents.'};","+        setDocuments(next);","+        undoRef.current.clear();","+        setActiveId(document.id);","+        setDraftTitle(document.title);","+        setDraft('');","+        setMode('NORMAL');","+        return {ok: true, status: `Created ${document.title}. Use :w to write changes.`};","+      },","+    });","+","+    const nextTape = pushTape(trimmed);","+    setTape(nextTape);","+    achRef.current = {...achRef.current, colonCommands: achRef.current.colonCommands + 1};","+    writeAch(achRef.current);","+    cmdsRef.current += 1;","+    awardCheck();","+","+    if ('reload' in result && (result as {reload?: boolean}).reload) {","+      if (activeDocument) {","+        undoRef.current.clear();","+        setDraft(activeDocument.content);","+        setDraftTitle(activeDocument.title);","+        setMode('NORMAL');","+        setStatus('Reloaded. Unsaved edits discarded.');","+      }","+      setCommand('');","+      return;","+    }","+    if (result.downloadAs !== undefined && result.downloadAs) {","+      setCommand('');","+      setMode('NORMAL');","+      focusEditor();","+      return;","+    }","+    if (result.draft !== undefined) setDraft(result.draft);","+    if (result.caret !== undefined && result.caret !== null) {","+      const c = result.caret;","+      focusEditor(c);","+    }","+    if ('pendingConfirm' in result && result.pendingConfirm) {","+      const pc = result.pendingConfirm;","+      setConfirm(pc);","+      const {draft: previewDraft} = applySubstitute(draft, pc.range.startLine, pc.range.endLine, pc.pattern, pc.replacement, pc.global);","+      setConfirmDraft(previewDraft);","+      setMode('NORMAL');","+      setStatus(`Confirm ${pc.matches} match(es): y replace, n skip, a all, q stop.`);","+      setCommand('');","+      return;","+    }","+    if (result.switchToInsert) {","+      insertMode(false);","+      setCommand('');","+      return;","+    }","+    if (result.showHelp) {","+      setOverlay('help');","+      setStatus(result.status);","+      setCommand('');","+      setMode('NORMAL');","+      focusEditor();","+      return;","+    }","+    if (result.closeEditor) {","+      setCommand('');","+      return;","+    }","+    if (result.error) setFailure(result.status);","+    else setStatus(result.status === 'NORMAL' ? 'NORMAL' : result.status);","+    setCommand('');","+    setMode(current => current === 'COMMAND' ? 'NORMAL' : current);","+    if (result.caret === undefined) focusEditor();","+  };"]}]}]}
