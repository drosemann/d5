ach.unlocked.length === 1 ? 'trophy' : 'trophies'}","+            </div>","+          )}","+        </aside>","+","+        <section className=\"editor-area\">","+          {activeDocument ? (","+            <>","+              <div className=\"editor-toolbar\">","+                <div className=\"breadcrumb\"><span>Documents</span><span className=\"crumb-divider\">/</span><span>{draftTitle || 'Untitled document'}</span></div>","+                <div className=\"document-actions\">","+                  <span className={`save-state ${isDirty ? 'dirty' : ''}`} aria-live=\"polite\">","+                    <span className=\"save-dot\" />{isDirty ? 'Unsaved changes' : 'Saved'}","+                  </span>","+                  <button className=\"button button-outline preview-toggle\" onClick={() => setPreview(p => !p)}>{preview ? 'Edit' : 'Preview'}</button>","+                  <button className=\"button button-primary save-button\" onClick={() => saveDocument()}>Write <kbd>⌘ S</kbd></button>","+                </div>","+              </div>","+              <div className={`editor-card ${writing ? 'is-writing' : ''}`}>","+                {writing && <div className=\"written-stamp\" aria-hidden=\"true\">WRITTEN</div>}","+                <label className=\"visually-hidden\" htmlFor=\"document-title\">Document title</label>","+                <input","+                  id=\"document-title\"","+                  className=\"title-input\"","+                  value={draftTitle}","+                  onChange={event => setDraftTitle(event.target.value)}","+                  placeholder=\"Untitled document\"","+                  spellCheck={false}","+                />","+                <div className={`mode-label ${mode.toLowerCase()}`}>{confirm ? 'CONFIRM' : mode}{confirm ? ' — y/n/a/q' : ''}</div>","+                {preview ? (","+                  <div className=\"preview-pane\" dangerouslySetInnerHTML={{__html: renderMarkdown(draft) || '<p class=\"md-empty\">Nothing to