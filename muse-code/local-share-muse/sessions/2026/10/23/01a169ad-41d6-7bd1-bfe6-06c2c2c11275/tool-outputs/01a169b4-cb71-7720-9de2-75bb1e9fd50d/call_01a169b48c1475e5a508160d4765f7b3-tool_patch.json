 className=\"overlay-grid\">","+                    <div><h4>Addresses</h4><p><code>:3</code> goto line · <code>:1,5p</code> print · <code>:%d</code> all · <code>.,$</code> here to end</p></div>","+                    <div><h4>Write &amp; quit</h4><p><code>:w [file]</code> save · <code>:q[!]</code> quit · <code>:wq</code> both · <code>:e[!] t</code> open</p></div>","+                    <div><h4>Substitute</h4><p><code>:s/a/b/g</code> · <code>:%s/a/b/gc</code> confirm · <code>/pat</code> <code>n/N</code></p></div>","+                    <div><h4>Normal</h4><p><code>w b e</code> words · <code>gg G</code> top/bottom · <code>A I O</code> · <code>r ~ J D C</code> · <code>yy p P u .</code> · <code>q:</code> tape</p></div>","+                    <div><h4>View</h4><p><code>:preview</code> toggle · <code>:history</code> <code>:restore N</code> · <code>:golf</code> score</p></div>","+                    <div><h4>Fun</h4><p><code>:gloom</code> candle mode · <code>:achievements</code> trophies · <code>:set sound|clerk=off|mild|full</code></p></div>","+                  </div>","+                </div>","+              )}","+              {overlay === 'tape' && (","+                <div className=\"overlay-card\" role=\"dialog\" aria-label=\"Command tape\">","+                  <div className=\"overlay-head\"><strong>q: command tape</strong><button className=\"button button-outline overlay-close\" onClick={() => {setOverlay(null); focusEditor();}}>Close <kbd>Esc</kbd></button></div>","+                  {tape.length === 0 ? <p className=\"overlay-empty\">No commands yet. Run something with : first.</p> : (","+                  <ul className=\"tape-list\">","+                    {tape.map((entry, i) => (","+                      <li key={`${i}-${entry}`} className={i === tapeIndex ? 'tape-selected' : ''}>","+                        <button onClick={() => replayTape(entry)} onMouseEnter={() => setTapeIndex(i)}>","+                          <span className=\"tape-num\">{i + 1}</span><code>:{entry}</code>","+                        </button>","+                      </li>","+                    ))}","+                  </ul>","+                  )}","+                </div>","+              )}","+              {overlay === 'achievements' && (","+                <div className=\"overlay-card\" role=\"dialog\" aria-label=\"Achievements\">","+                  <div className=\"overlay-head\"><strong>Achievements</strong><button className=\"button button-outline overlay-close\" onClick={() => {setOverlay(null); focusEditor();}}>Close <kbd>Esc</kbd></button></div>","+                  <ul className=\"ach-list\">","+                    {ACHIEVEMENTS.map(a => (","+                      <li key={a.id} className={ach.unlocked.includes(a.id) ? 'ach-unlocked' : 'ach-locked'}>","+                        <span aria-hidden=\"true\">{ach.unlocked.includes(a.id) ? '★' : '☆'}</span>","+                        <span><strong>{a.title}</strong> — {a.desc}</span>","+                      </li>","+                    ))}","+                  </ul>","+                </div>","+              )}","+              {overlay === 'snapshots' && (","+                <div className=\"overlay-card\" role=\"dialog\" aria-label=\"Snapshots\">","+                  <div className=\"overlay-head\"><strong>:history — snapshots on every :w</strong><button className=\"button button-outline overlay-close\" onClick={() => {setOverlay(null); focusEditor();}}>Close <kbd>Esc</kbd></button></div>","+                  {snaps.length === 0 ? <p className=\"overlay-empty\">No snapshots yet. :w first.</p> : (","+                  <ul className=\"snap-list\">","+                    {snaps.map((s, i) => (","+                      <li key={`${s.ts}-${i}`}>","+                        <button onClick={() => runRestoreCommand(String(i + 1))}>","+                          <span className=\"tape-num\">{i + 1}</span>","+                          <span>{new Date(s.ts).toLocaleString()} — {s.lines} lines</span>","+                        </button>","+                      </li>","+                    ))}","+                  </ul>","+                  )}","+                </div>","+              )}","+              <form className=\"command-bar\" onSubmit={event => {","+                event.preventDefault();","+                if (overlay === 'tape' && tape[tapeIndex]) {","+                  replayTape(tape[tapeIndex]);","+                } else if (command.startsWith('/')) {","+                  runCommand(command);","+                } else {","+                  runExCommand(command.replace(/^:/, ''));","+                }","+                requestAnimationFrame(() => editorRef.current?.focus());","+              }}>","+                <label htmlFor=\"command-input\" className=\"command-prefix\">{mode === 'COMMAND' ? ':' : '>'}</label>","+                <input","+                  ref={commandRef}","+                  id=\"command-input\"","+                  value={command}","+                  onFocus={() => {if (mode !== 'COMMAND') setMode('COMMAND');}}","+                  onBlur={() => {if (mode === 'COMMAND') setMode('NORMAL');}}","+                  onChange={event => setCommand(event.target.value)}","+                  onKeyDown={event => {","+                    if (event.key === 'Escape') {setCommand(''); setMode('NORMAL'); setOverlay(null); editorRef.current?.focus();}","+                    if (overlay === 'tape' && event.key === 'ArrowUp') {event.preventDefault(); setTapeIndex(i => Math.max(0, i - 1));}","+                    if (overlay === 'tape' && event.key === 'ArrowDown') {event.preventDefault(); setTapeIndex(i => Math.min(tape.length - 1, i + 1));}","+                  }}","+                  placeholder=\"Type a command — try help\"","+                  autoComplete=\"off\"","+                  spellCheck={false}","+                />","+                <span className=\"command-hint\">Enter to run <kbd>Esc</kbd></span>","+              </form>","+              <div className={`status-line ${status.startsWith('?') ? 'status-error' : ''}`} role=\"status\">","+                <span className=\"status-prompt\">{status.startsWith('?') ? '?' : status.startsWith('★') || status.includes('★') ? '★' : '●'}</span>","+                <span>{status.replace(/^\\?\\s?/, '')}</span>","+                <span className=\"status-shortcuts\">i insert <b>·</b> : command <b>·</b> q: tape <b>·</b> Esc normal</span>","+              </div>","+            </>","+          ) : (","+            <div className=\"welcome\">","+              <div className=\"welcome-card\">","+                <div className=\"welcome-symbol\">e<span>.</span></div>","+                <p className=\"eyebrow\">A QUIETER KIND OF DOCUMENT</p>","+                <h2>Just you and the page.</h2>","+                <p className=\"welcome-copy\">Write in Markdown. Work offline. Save when you mean it. Your documents stay in this browser unless you export them.</p>","+                <button className=\"button button-primary welcome-button\" onClick={() => makeDocument()}>","+                  <span aria-hidden=\"true\">+</span> Create your first document","+                </button>","+                <div className=\"welcome-prompt\"><kbd>i</kbd> to insert <span>·</span> <kbd>Esc</kbd> to stop <span>·</span> <kbd>:w</kbd> to write</div>","+              </div>","+            </div>","+          )}","+        </section>","+      </div>","+      <footer className=\"app-footer\">","+        <span>ed-docs <span className=\"footer-divider\">·</span> offline-first, intentionally small</span>","+        <span>{offlineError ? 'Offline cache unavailable' : offlineReady ? 'App shell cached for offline use' : 'Offline cache initializing'}</span>","+      </footer>","+    </main>","+  );","+}","+","+createRoot(document.getElementById('root')!).render(","+  <React.StrictMode>","+    <App />","+  </React.StrictMode>,","+);"]}]}]}