{"files":[{"path":"\\\\?\\C:\\Users\\danie\\OneDrive\\github-repos\\forum-for-nerds\\prisma\\schema.prisma","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":110,"lines":["+// Canonical data model for forum-for-nerds.","+// Reused from legacy \"blog-forum-with-z.ai\" (prisma/schema.prisma).","+// SQLite for local dev; point DATABASE_URL at MariaDB in prod.","+","+generator client {","+  provider = \"prisma-client-js\"","+}","+","+datasource db {","+  provider = \"sqlite\"","+  url      = env(\"DATABASE_URL\")","+}","+","+model User {","+  id        String    @id @default(cuid())","+  email     String    @unique","+  name      String?","+  avatar    String?","+  bio       String?","+  role      String    @default(\"user\") // user | mod | admin","+  posts     Post[]","+  threads   Thread[]","+  comments  Comment[]","+  votes     Vote[]","+  createdAt DateTime  @default(now())","+  updatedAt DateTime  @updatedAt","+}","+","+model Post {","+  id          String    @id @default(cuid())","+  title       String","+  content     String?","+  excerpt     String?","+  published   Boolean   @default(false)","+  featured    Boolean   @default(false)","+  authorId    String","+  author      User      @relation(fields: [authorId], references: [id])","+  tags        Tag[]","+  category    String?","+  votes       Int       @default(0)","+  views       Int       @default(0)","+  comments    Comment[]","+  createdAt   DateTime  @default(now())","+  updatedAt   DateTime  @updatedAt","+  publishDate DateTime?","+  status      String    @default(\"draft\") // draft | scheduled | published | archived","+}","+","+model Thread {","+  id        String    @id @default(cuid())","+  title     String","+  content   String","+  authorId  String","+  author    User      @relation(fields: [authorId], references: [id])","+  category  String?","+  pinned    Boolean   @default(false)","+  locked    Boolean   @default(false)","+  trending  Boolean   @default(false)","+  votes     Int       @default(0)","+  views     Int       @default(0)","+  replies   Comment[]","+  tags      String[]","+  createdAt DateTime  @default(now())","+  updatedAt DateTime  @updatedAt","+  lastReply DateTime?","+}","+","+model Comment {","+  id        String    @id @default(cuid())","+  content   String","+  authorId  String","+  author    User      @relation(fields: [authorId], references: [id])","+  postId    String?","+  post      Post?     @relation(fields: [postId], references: [id])","+  threadId  String?","+  thread    Thread?   @relation(fields: [threadId], references: [id])","+  parentId  String?","+  parent    Comment?  @relation(\"CommentReplies\", fields: [parentId], references: [id])","+  replies   Comment[] @relation(\"CommentReplies\")","+  votes     Int       @default(0)","+  createdAt DateTime  @default(now())","+  updatedAt DateTime  @updatedAt","+}","+","+model Tag {","+  id        String   @id @default(cuid())","+  name      String   @unique","+  posts     Post[]","+  createdAt DateTime @default(now())","+  updatedAt DateTime @updatedAt","+}","+","+model Vote {","+  id        String   @id @default(cuid())","+  userId    String","+  user      User     @relation(fields: [userId], references: [id])","+  postId    String?","+  post      Post?    @relation(fields: [postId], references: [id])","+  threadId  String?","+  thread    Thread?  @relation(fields: [threadId], references: [id])","+  commentId String?","+  comment   Comment? @relation(fields: [commentId], references: [id])","+  value     Int","+  createdAt DateTime @default(now())","+  updatedAt DateTime @updatedAt","+","+  @@unique([userId, postId])","+  @@unique([userId, threadId])","+  @@unique([userId, commentId])","+}"]}]}]}