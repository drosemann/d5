// {"files":[{"path":"\\\\?\\C:\\Users\\danie\\OneDrive\\github-repos\\ai-chat-webui\\auth.js","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":165,"lines":["+import { supabase } from './supabaseClient.js';","+","+const authRoot = document.getElementById('auth-root');","+const appRoot = document.getElementById('app-root');","+","+function escapeHtml(value) {","+  return String(value ?? '')","+    .replace(/&/g, '&amp;')","+    .replace(/</g, '&lt;')","+    .replace(/>/g, '&gt;')","+    .replace(/\"/g, '&quot;')","+    .replace(/'/g, '&#39;');","+}","+","+function showError(message) {","+  const box = authRoot.querySelector('[data-auth-error]');","+  if (box) {","+    box.hidden = false;","+    box.textContent = message;","+  }","+}","+","+function clearError() {","+  const box = authRoot.querySelector('[data-auth-error]');","+  if (box) {","+    box.hidden = true;","+    box.textContent = '';","+  }","+}","+","+function validDisplayName(value) {","+  const name = value.trim();","+  return name.length >= 1 && name.length <= 60 ? name : null;","+}","+","+async function ensureProfile(displayNameFromSignup) {","+  const { data: sessionData } = await supabase.auth.getSession();","+  const user = sessionData.session?.user;","+  if (!user) return null;","+","+  const { data: profile } = await supabase","+    .from('profiles')","+    .select('id, display_name')","+    .eq('id', user.id)","+    .maybeSingle();","+","+  if (profile) return profile;","+","+  const fallback = validDisplayName(","+    displayNameFromSignup || user.user_metadata?.display_name || ''","+  ) || 'New member';","+","+  const { data: created, error } = await supabase","+    .from('profiles')","+    .upsert({ id: user.id, display_name: fallback }, { onConflict: 'id' })","+    .select('id, display_name')","+    .single();","+","+  if (error) {","+    showError(`Could not load your profile: ${error.message}`);","+    return null;","+  }","+  return created;","+}","+","+function renderAuthView(route) {","+  const safeRoute = route === '#/signup' || route === '#/forgot' || route === '#/reset' ? route : '#/login';","+  const nameField = safeRoute === '#/signup'","+    ? '<label>Display name<input name=\"displayName\" maxlength=\"60\" autocomplete=\"nickname\" required></label>'","+    : '';","+  const passwordField = safeRoute === '#/forgot'","+    ? ''","+    : '<label>Password<input name=\"password\" type=\"password\" autocomplete=\"current-password\" required></label>';","+  const submitLabel = safeRoute === '#/signup' ? 'Create account' : safeRoute === '#/forgot' ? 'Send reset link' : safeRoute === '#/reset' ? 'Set new password' : 'Sign in';","+","+  authRoot.innerHTML = `","+    <div class=\"auth-card\">","+      <h1>AI Chat Workspace</h1>","+      <p>Sign in to your self-hosted workspace.</p>","+      <div data-auth-error class=\"auth-error\" hidden></div>","+      <form data-auth-form>","+        ${nameField}","+        <label>Email<input name=\"email\" type=\"email\" autocomplete=\"email\" required></label>","+        ${passwordField}","+        <button type=\"submit\">${escapeHtml(submitLabel)}</button>","+      </form>","+      <nav class=\"auth-links\">","+        <a href=\"#/login\">Sign in</a>","+        <a href=\"#/signup\">Create account</a>","+        <a href=\"#/forgot\">Forgot password</a>","+      </nav>","+    </div>`;","+}","+","+async function handleAuthSubmit(event) {","+  event.preventDefault();","+  clearError();","+  const form = new FormData(event.target);","+  const email = String(form.get('email') || '').trim();","+  const password = String(form.get('password') || '');","+  const displayName = validDisplayName(String(form.get('displayName') || ''));","+  const hash = window.location.hash || '#/login';","+","+  try {","+    if (hash === '#/signup') {","+      if (!displayName) throw new Error('Please enter a display name with 1–60 characters.');","+      const { error } = await supabase.auth.signUp({","+        email,","+        password,","+        options: { data: { display_name: displayName } }","+      });","+      if (error) throw error;","+      await ensureProfile(displayName);","+    } else if (hash === '#/forgot') {","+      const { error } = await supabase.auth.resetPasswordForEmail(email, {","+        redirectTo: `${window.location.origin}/#/reset`","+      });","+      if (error) throw error;","+      showError('If that address has an account, a reset link is on its way.');","+      return;","+    } else if (hash === '#/reset') {","+      const { error } = await supabase.auth.updateUser({ password });","+      if (error) throw error;","+    } else {","+      const { error } = await supabase.auth.signInWithPassword({ email, password });","+      if (error) throw error;","+      await ensureProfile('');","+    }","+  } catch (error) {","+    showError(error?.message || 'Authentication failed.');","+  }","+}","+","+function applySession(session) {","+  const signedIn = Boolean(session);","+  authRoot.hidden = signedIn;","+  appRoot.hidden = !signedIn;","+  if (!signedIn && !window.location.hash.startsWith('#/')) {","+    window.location.hash = '#/login';","+  }","+}","+","+async function initAuth() {","+  renderAuthView(window.location.hash);","+  authRoot.addEventListener('submit', (event) => {","+    if (event.target.matches('[data-auth-form]')) handleAuthSubmit(event);","+  });","+  window.addEventListener('hashchange', () => {","+    if (!authRoot.hidden) {","+      clearError();","+      renderAuthView(window.location.hash);","+    }","+  });","+","+  const { data } = await supabase.auth.getSession();","+  applySession(data.session);","+  if (data.session) await ensureProfile('');","+","+  supabase.auth.onAuthStateChange(async (_event, session) => {","+    applySession(session);","+    if (session) await ensureProfile('');","+  });","+}","+","+initAuth();"]}]}]}
