// {"files":[{"path":"\\\\?\\C:\\Users\\danie\\OneDrive\\github-repos\\ai-chat-webui\\server.js","hunks":[{"oldStart":158,"oldLines":6,"newStart":158,"newLines":36,"lines":["     }"," });"," ","+let tagsCache = { at: 0, models: null };","+","+async function listOllamaModels() {","+    if (tagsCache.models && Date.now() - tagsCache.at < 60000) {","+        return tagsCache.models;","+    }","+    const base = OLLAMA_API_URL.replace(/\\/api\\/generate\\/?$/, '');","+    const response = await fetch(`${base}/api/tags`);","+    if (!response.ok) {","+        throw new Error(`Ollama tags request failed: ${response.status}`);","+    }","+    const data = await response.json();","+    tagsCache = { at: Date.now(), models: (data.models || []).map((m) => m.name).filter(Boolean) };","+    return tagsCache.models;","+}","+","+app.get('/api/models', async (req, res) => {","+    const auth = verifySupabaseToken(req.headers.authorization);","+    if (!auth.ok) {","+        return res.status(auth.status).json({ error: auth.error });","+    }","+    try {","+        const models = await listOllamaModels();","+        res.json({ models, defaultModel: OLLAMA_DEFAULT_MODEL });","+    } catch (error) {","+        console.error('Ollama tags error:', error);","+        res.status(502).json({ error: 'Ollama is unreachable. Check OLLAMA_API_URL.' });","+    }","+});","+"," app.get('/health', (req, res) => {","     res.json({ status: 'ok', timestamp: new Date().toISOString() });"," });"]}]}]}
