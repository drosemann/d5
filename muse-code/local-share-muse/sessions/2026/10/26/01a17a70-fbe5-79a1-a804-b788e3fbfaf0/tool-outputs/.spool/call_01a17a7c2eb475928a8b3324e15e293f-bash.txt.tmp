6: container_name: infra-pilot-postgres
11: ports:
39: container_name: infra-pilot-redis
41: ports:
67: management-panel:
69: context: ./services/management-panel
77: container_name: infra-pilot-management-panel
89: ports:
91: - "${MANAGEMENT_BACKEND_PORT:-3001}:3001"
116: app.kubernetes.io/component: management-panel
124: container_name: infra-pilot-orchestrator
135: ports:
169: container_name: infra-pilot-discord
190: API_BASE_URL: http://management-panel:3001
209: ports:
242: container_name: infra-pilot-prometheus
246: ports:
272: container_name: infra-pilot-grafana
277: ports:
