{"files":[{"path":"\\\\?\\C:\\Users\\danie\\OneDrive\\github-repos\\infra-pilot\\services\\management-panel\\server\\index.ts","hunks":[{"oldStart":4469,"oldLines":6,"newStart":4469,"newLines":121,"lines":["   res.json(result);"," });"," ","+// ============================================================================","+// FEATURE FLAGS — panel is the single source of truth (DB), thin consumers","+// read via /evaluate. Authoritative server-side evaluation only; the browser","+// receives resolved values, never targeting rules.","+// ============================================================================","+async function requireFlagAdmin(req: Request, res: Response): Promise<string | null> {","+  const userId = (req as any).user.id;","+  const { data: profile } = await supabase.from('user_profiles').select('role').eq('id', userId).maybeSingle();","+  if (profile?.role !== 'admin') {","+    res.status(403).json({ error: 'Admin required' });","+    return null;","+  }","+  return userId;","+}","+","+async function loadFlagsFromDb(): Promise<any[]> {","+  const { data: flags } = await supabase.from('feature_flags').select('*').eq('status', 'active');","+  const { data: rules } = await supabase.from('feature_flag_rules').select('*');","+  return (flags || []).map((f: any) => ({","+    ...f,","+    rules: Object.fromEntries((rules || []).filter((r: any) => r.flag_key === f.key).map((r: any) => [r.environment, r])),","+  }));","+}","+","+function withRegistryFallback(dbFlags: any[]): any[] {","+  const seen = new Set(dbFlags.map((f: any) => f.key));","+  return [...dbFlags, ...FLAG_REGISTRY.filter((f) => !seen.has(f.key))];","+}","+","+// GET /api/feature-flags/evaluate — any authenticated user, resolved map only.","+app.get('/api/feature-flags/evaluate', verifyAuth, async (req: Request, res: Response) => {","+  try {","+    const env = (process.env.NODE_ENV === 'production' ? 'production' : 'development') as 'development' | 'staging' | 'production';","+    const subject = {","+      userId: (req as any).user.id,","+      orgId: req.query.orgId as string | undefined,","+      projectId: req.query.projectId as string | undefined,","+    };","+    let flags: any[] = FLAG_REGISTRY;","+    try {","+      flags = withRegistryFallback(await loadFlagsFromDb());","+    } catch {","+      // DB down: fall through to compiled-in registry + env overrides.","+    }","+    const out: Record<string, boolean | string> = {};","+    for (const f of flags) {","+      const ov = envOverride(f.key);","+      out[f.key] = ov !== null ? ov : evaluateFlag(f, env, subject);","+    }","+    res.json({ evaluatedAt: new Date().toISOString(), environment: env, flags: out });","+  } catch (err: any) {","+    res.status(500).json({ error: err.message });","+  }","+});","+","+// GET /api/feature-flags — admin: full definitions + rules.","+app.get('/api/feature-flags', verifyAuth, async (req: Request, res: Response) => {","+  const userId = await requireFlagAdmin(req, res);","+  if (!userId) return;","+  try {","+    res.json({ flags: withRegistryFallback(await loadFlagsFromDb()) });","+  } catch (err: any) {","+    res.status(500).json({ error: err.message });","+  }","+});","+","+// POST /api/feature-flags — admin: create flag + per-env rules.","+app.post('/api/feature-flags', verifyAuth, async (req: Request, res: Response) => {","+  const userId = await requireFlagAdmin(req, res);","+  if (!userId) return;","+  const { key, description, value_type, default_value, fail_mode, expires_at, rules } = req.body;","+  if (!validateFlagKey(key)) return res.status(400).json({ error: 'Invalid flag key slug' });","+  const { data, error } = await supabase.from('feature_flags').insert({","+    key, description: description || '', value_type: value_type || 'boolean',","+    default_value: default_value ?? false, fail_mode: fail_mode || 'closed',","+    expires_at: expires_at || null, created_by: userId,","+  }).select().single();","+  if (error) return res.status(400).json({ error: error.message });","+  for (const r of rules || []) {","+    const errMsg = validateRule(r);","+    if (errMsg) return res.status(400).json({ error: errMsg });","+    await supabase.from('feature_flag_rules').upsert({ flag_key: key, ...r, updated_by: userId });","+  }","+  await logAudit(userId, 'flag:create', 'feature_flag', key, null, req.body, (req as any).ip);","+  res.status(201).json({ flag: data });","+});","+","+// PATCH /api/feature-flags/:key — admin: update definition or env rule.","+app.patch('/api/feature-flags/:key', verifyAuth, async (req: Request, res: Response) => {","+  const userId = await requireFlagAdmin(req, res);","+  if (!userId) return;","+  const { data: before } = await supabase.from('feature_flags').select('*').eq('key', req.params.key).maybeSingle();","+  if (req.body.rule) {","+    const errMsg = validateRule(req.body.rule);","+    if (errMsg) return res.status(400).json({ error: errMsg });","+    const { error } = await supabase.from('feature_flag_rules').upsert({ flag_key: req.params.key, ...req.body.rule, updated_by: userId });","+    if (error) return res.status(400).json({ error: error.message });","+  } else {","+    const { error } = await supabase.from('feature_flags').update(req.body).eq('key', req.params.key);","+    if (error) return res.status(400).json({ error: error.message });","+  }","+  await logAudit(userId, 'flag:update', 'feature_flag', req.params.key, before, req.body, (req as any).ip);","+  res.json({ ok: true });","+});","+","+// POST /api/feature-flags/:key/kill — admin: instant kill switch (all envs off).","+app.post('/api/feature-flags/:key/kill', verifyAuth, async (req: Request, res: Response) => {","+  const userId = await requireFlagAdmin(req, res);","+  if (!userId) return;","+  const { data: before } = await supabase.from('feature_flag_rules').select('*').eq('flag_key', req.params.key);","+  await supabase.from('feature_flag_rules').update({ enabled: false, rollout_percentage: 0 }).eq('flag_key', req.params.key);","+  await logAudit(userId, 'flag:kill', 'feature_flag', req.params.key, before, { enabled: false }, (req as any).ip);","+  res.json({ ok: true, killed: req.params.key });","+});","+"," // Global error handling middleware"," app.use((err: Error, _req: Request, res: Response, _next: NextFunction) => {","   console.error('[Server] Unhandled error:', err.message || err);"]}]}]}