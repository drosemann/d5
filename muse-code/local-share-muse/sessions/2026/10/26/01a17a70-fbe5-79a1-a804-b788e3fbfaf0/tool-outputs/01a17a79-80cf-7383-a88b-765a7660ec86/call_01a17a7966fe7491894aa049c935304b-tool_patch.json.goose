// {"files":[{"path":"\\\\?\\C:\\Users\\danie\\OneDrive\\github-repos\\infra-pilot\\services\\management-panel\\src\\lib\\feature-flags.ts","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":46,"lines":["+/**","+ * @file Typed client for the panel feature-flag evaluate endpoint.","+ * The browser only ever receives resolved values, never targeting rules.","+ */","+","+import { apiClient } from './api';","+","+export type FlagKey = 'discord_service_v2' | 'living_fleet' | (string & {});","+","+interface EvaluateResponse {","+  evaluatedAt: string;","+  environment: string;","+  flags: Record<string, boolean | string>;","+}","+","+let cache: { at: number; flags: Record<string, boolean | string> } | null = null;","+const TTL_MS = 30_000;","+","+export async function fetchEvaluatedFlags(force = false): Promise<Record<string, boolean | string>> {","+  if (!force && cache && Date.now() - cache.at < TTL_MS) return cache.flags;","+  const res = await (apiClient as any).api.get<EvaluateResponse>('/api/feature-flags/evaluate');","+  cache = { at: Date.now(), flags: res.data.flags || {} };","+  return cache.flags;","+}","+","+export function readCachedFlag(key: string, fallback: boolean | string = false): boolean | string {","+  if (cache && key in cache.flags) return cache.flags[key];","+  return envFlagOverride(key, fallback);","+}","+","+/** Local escape hatch for dev/incidents: VITE_FEATURE_FLAG_<KEY>. */","+export function envFlagOverride(key: string, fallback: boolean | string): boolean | string {","+  try {","+    const raw = (import.meta as any).env?.[`VITE_FEATURE_FLAG_${key.toUpperCase().replace(/[^A-Z0-9]/g, '_')}`];","+    if (raw === 'true') return true;","+    if (raw === 'false') return false;","+    if (raw !== undefined) return raw;","+  } catch {","+    // non-browser / no env — fall through","+  }","+  return fallback;","+}","+","+export function invalidateFlagCache(): void {","+  cache = null;","+}"]}]}]}
