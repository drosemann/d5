templates
Chart.yaml
values.yaml
# Default values for infra-pilot Helm chart

# replicaCount is used when autoscaling.enabled=false. When HPA is enabled
# (default) the HPA controls replicas (minReplicas 2). Use 1 for
# non-HPA to avoid duplicate ManifestEngine reconciliation without
# distributed coordination; see templates/deployment.yaml.
replicaCount: 1

global:
  environment: production
  imageRegistry: ghcr.io/drosemann

image:
  repository: infra-pilot
  pullPolicy: IfNotPresent
  # Empty tag defaults to Chart.AppVersion for reproducible deployments
  tag: ""

nameOverride: ""
fullnameOverride: ""

serviceAccount:
  create: true
  annotations: {}
  name: ""

podAnnotations: {}
podSecurityContext:
  runAsNonRoot: true
  seccompProfile:
    type: RuntimeDefault
securityContext:
  runAsNonRoot: true
  runAsUser: 1000
  runAsGroup: 1000
  allowPrivilegeEscalation: false
  readOnlyRootFilesystem: true
  capabilities:
    drop:
      - ALL

service:
  type: ClusterIP
  port: 8500

ingress:
  enabled: true
  className: nginx
  annotations:
    cert-manager.io/cluster-issuer: letsencrypt-prod
    nginx.ingress.kubernetes.io/ssl-redirect: "true"
    nginx.ingress.kubernetes.io/proxy-body-size: "50m"
  hosts:
    - host: api.infra-pilot.example.com
      paths:
        - path: /
          pathType: Prefix
  tls:
    - secretName: infra-pilot-tls
      hosts:
