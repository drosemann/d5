    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --pretty false",
    "preview": "vite preview",
    "test:playwright": "npx playwright test --config playwright.config.ts",
    "playwright:install": "npx playwright install",
    "seed:customers": "node ./scripts/seed-customers.mjs",
    "test": "NODE_ENV=test node --test tests/**/*.test.ts",
    "test:coverage": "NODE_ENV=test NODE_V8_COVERAGE=coverage/v8 node --test --experimental-test-coverage tests/**/*.test.ts --test-coverage-lines=35 --test-coverage-functions=25 --test-coverage-branches=20 --test-coverage-statements=35",
    "test:api": "NODE_ENV=test node --test tests/integration/**/*.test.ts",
    "test:unit": "NODE_ENV=test node --test tests/unit/**/*.test.ts",
