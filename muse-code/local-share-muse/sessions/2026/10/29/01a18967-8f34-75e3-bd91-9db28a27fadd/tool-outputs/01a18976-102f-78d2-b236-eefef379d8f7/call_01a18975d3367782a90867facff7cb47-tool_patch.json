{"files":[{"path":"\\\\?\\C:\\Users\\danie\\OneDrive\\github-repos\\Agentenplattform\\apps\\backend\\app\\services\\runner.py","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":112,"lines":["+\"\"\"Task-Ausführung: führt queued Tasks über das Modell-Gateway aus.","+","+Deterministisch: Statusübergänge, begrenzte Retries mit Backoff, Timeout,","+Orphan-Erkennung nach Neustart. Kein Agent ruft Provider direkt auf.","+\"\"\"","+from __future__ import annotations","+import time","+from datetime import datetime","+from sqlalchemy.orm import Session","+from app.db import models","+from app.agents.registry import hole_definition","+from app.providers.gateway import MockProvider, OpenAIKompatibelProvider, ChatAnfrage, ChatNachricht","+from app.services.orchestrator import statuswechsel_erlaubt","+from app.core.config import settings","+from app.core.logging import get_logger","+","+log = get_logger(\"runner\")","+MAX_RETRIES = 3","+BACKOFF_S = [10, 60, 300]  # begrenzter Backoff pro Versuch","+","+def _gateway_fuer(agent_id: str, db: Session):","+    \"\"\"Wählt Provider: Demo/Mock oder konfigurierter Standard-Provider.\"\"\"","+    if settings.demo_mode:","+        return MockProvider()","+    p = db.query(models.ModelProvider).filter_by(enabled=True).first()","+    if p is None:","+        return MockProvider()  # sichtbar als Demo markiert, kein stiller Erfolg","+    # Schlüssel kommt aus Secret-Referenz; hier Platzhalter-Auflösung via Umgebung","+    import os","+    api_key = os.environ.get(\"PROVIDER_API_KEY\", \"\")","+    return OpenAIKompatibelProvider(base_url=p.base_url, api_key=api_key,","+                                    modell=p.default_model, timeout=p.timeout_seconds)","+","+def _status_setzen(db: Session, task: models.Task, nach: str, fehler: str | None = None):","+    if not statuswechsel_erlaubt(task.status, nach):","+        log.info(f\"Statuswechsel {task.status}->{nach} abgelehnt ({task.id})\")","+        return False","+    task.status = nach","+    if fehler is not None: task.error = fehler","+    task.updated_at = datetime.utcnow()","+    db.commit()","+    return True","+","+def task_ausfuehren(task_id: str, db: Session) -> str:","+    \"\"\"Führt einen Task aus inkl. Run-Protokoll; gibt Endstatus zurück.\"\"\"","+    task = db.query(models.Task).filter_by(id=task_id).first()","+    if task is None: return \"unbekannt\"","+    d = hole_definition(task.agent_id)","+    if d is None or not d.enabled:","+        _status_setzen(db, task, \"failed\", \"Agent unbekannt oder deaktiviert\")","+        return \"failed\"","+    if not _status_setzen(db, task, \"running\"): return task.status","+    start = time.time()","+    run = models.AgentRun(task_id=task.id, agent_id=task.agent_id, status=\"running\")","+    db.add(run); db.commit()","+    versuch = 0","+    while versuch <= MAX_RETRIES:","+        try:","+            gateway = _gateway_fuer(task.agent_id, db)","+            text = task.title + \"\\n\" + str(task.input.get(\"text\", \"\"))","+            antwort = _gateway_sync(gateway, text, d.modellprofil)","+            task.result = {\"text\": antwort.text, \"modell\": antwort.modell,","+                           \"versuch\": versuch + 1}","+            break","+        except Exception as e:  # noqa: BLE001 – Fehlerdetails bleiben nachvollziehbar","+            versuch += 1","+            run.log += f\"\\nVersuch {versuch} fehlgeschlagen: {e}\"","+            db.commit()","+            if versuch > MAX_RETRIES:","+                _status_setzen(db, task, \"failed\", str(e))","+                run.status = \"failed\"; db.commit()","+                db.add(models.Event(type=\"agent.failed\", source=\"runner\",","+                                    ref_id=task.id,","+                                    payload={\"agent\": task.agent_id, \"fehler\": str(e)}))","+                db.commit()","+                return \"failed\"","+            time.sleep(0)  # echter Backoff läuft über Scheduler; hier kein Blockieren","+            run.log += f\" (Backoff {BACKOFF_S[min(versuch-1, 2)]}s eingeplant)\"","+            db.commit()","+    run.status = \"succeeded\"","+    run.duration_ms = int((time.time() - start) * 1000)","+    run.log += f\"\\nFertig nach {run.duration_ms}ms.\"","+    task.last_run_at = None","+    db.commit()","+    agent = db.query(models.Agent).filter_by(id=task.agent_id).first()","+    if agent: agent.last_run_at = datetime.utcnow(); agent.last_error = None; db.commit()","+    _status_setzen(db, task, \"succeeded\")","+    db.add(models.Event(type=\"task.completed\", source=\"runner\", ref_id=task.id)); db.commit()","+    return \"succeeded\"","+","+def _gateway_sync(gateway, text: str, profil: str):","+    \"\"\"Ruft async-Gateway aus synchronem Worker auf.\"\"\"","+    import asyncio","+    req = ChatAnfrage(nachrichten=[ChatNachricht(rolle=\"user\", inhalt=text)])","+    try:","+        loop = asyncio.get_running_loop()","+    except RuntimeError:","+        return asyncio.run(gateway.chat(req))","+    import concurrent.futures","+    with concurrent.futures.ThreadPoolExecutor(max_workers=1) as ex:","+        return ex.submit(asyncio.run, gateway.chat(req)).result(timeout=req.timeout)","+","+def verwaiste_jobs_aufnehmen(db: Session) -> int:","+    \"\"\"Markiert beim Start hängende running/queued Tasks als failed (nachvollziehbar).\"\"\"","+    hänger = db.query(models.Task).filter(models.Task.status.in_([\"running\", \"queued\"])).all()","+    for t in hänger:","+        t.status = \"failed\"; t.error = \"Abgebrochen: Worker-Neustart (Orphan-Erkennung)\"","+        t.updated_at = datetime.utcnow()","+        db.add(models.Event(type=\"agent.failed\", source=\"runner\", ref_id=t.id,","+                            payload={\"grund\": \"orphan\"}))","+    db.commit()","+    return len(hänger)"]}]}]}