// ---- Original-Code (muse-code/local-share-muse/sessions/2026/10/29/01a18967-8f34-75e3-bd91-9db28a27fadd/tool-outputs/01a1896b-7446-76b2-a9ef-99bf8c0734df/call_01a1896b32b1703cbeb68cb9d388a767-tool_patch.json), unveraendert, als Inline-Doku ----
// {"files":[{"path":"\\\\?\\C:\\Users\\danie\\OneDrive\\github-repos\\Agentenplattform\\apps\\backend\\app\\main.py","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":96,"lines":["+\"\"\"FastAPI-App: Health, Auth, Agenten, Tasks, Provider, Markt, Safety, Fassade.\"\"\"","+from fastapi import FastAPI, Depends, HTTPException, Header","+from fastapi.middleware.cors import CORSMiddleware","+from pydantic import BaseModel","+from sqlalchemy.orm import Session","+from app.db.base import Base, engine, get_db","+from app.db import models","+from app.security.auth import hash_passwort, pruefe_passwort, erstelle_token, lese_token, rate_limit","+from app.agents.registry import AGENTEN","+from app.services.orchestrator import auftrag_anlegen, statuswechsel_erlaubt","+from app.services.mail import absender_erlaubt","+from app.services.safety import sos_validieren","+from app.core.config import settings","+import uuid","+","+Base.metadata.create_all(bind=engine)","+app = FastAPI(title=\"Agentenplattform\", docs_url=\"/docs\")","+app.add_middleware(CORSMiddleware, allow_origins=[\"*\"], allow_methods=[\"*\"], allow_headers=[\"*\"])","+","+def aktuell(x_auth: str = Header(default=\"\")) -> str:","+    sub = lese_token(x_auth.replace(\"Bearer \", \"\")) if x_auth else None","+    # Demo-Modus: ohne Token als Besitzer arbeiten (Produktion: 401)","+    if sub: return sub","+    if settings.app_env != \"production\": return \"demo-besitzer\"","+    raise HTTPException(401, \"Anmeldung erforderlich\")","+","+@app.get(\"/health/live\")","+def live(): return {\"status\": \"lebendig\"}","+@app.get(\"/health/ready\")","+def ready(): return {\"status\": \"bereit\", \"demo_modus\": settings.demo_mode}","+","+class Login(BaseModel): email: str; passwort: str","+@app.post(\"/api/v1/auth/login\")","+def login(b: Login, db: Session = Depends(get_db)):","+    if not rate_limit(b.email): raise HTTPException(429, \"Zu viele Versuche – bitte warten.\")","+    if settings.demo_mode and b.email == \"demo@lokal\": return {\"token\": erstelle_token(\"demo-besitzer\")}","+    u = db.query(models.User).filter_by(email=b.email).first()","+    if not u or not pruefe_passwort(b.passwort, u.password_hash): raise HTTPException(401, \"Falsche Zugangsdaten\")","+    return {\"token\": erstelle_token(u.id)}","+","+@app.get(\"/api/v1/agents\")","+def agenten(_: str = Depends(aktuell)):","+    return [{\"id\": a.id, \"name\": a.name, \"beschreibung\": a.beschreibung, \"aktiv\": a.enabled} for a in AGENTEN.values()]","+","+class TaskNeu(BaseModel): agent_id: str | None = None; titel: str; eingabe: dict = {}","+@app.post(\"/api/v1/tasks\")","+def task_anlegen(b: TaskNeu, db: Session = Depends(get_db), user: str = Depends(aktuell)):","+    r = auftrag_anlegen(b.agent_id, b.titel, b.eingabe)","+    t = models.Task(agent_id=r[\"agent_id\"], title=b.titel, input=b.eingabe, status=\"queued\", idempotency_key=str(uuid.uuid4()))","+    db.add(t); db.add(models.Event(type=\"task.created\", source=\"api\", ref_id=t.id)); db.commit()","+    db.add(models.AuditLog(actor=user, aktion=\"task.created\", detail=t.id)); db.commit()","+    return {\"id\": t.id, \"agent_id\": t.agent_id, \"status\": t.status, \"hinweis\": r[\"hinweis\"]}","+@app.get(\"/api/v1/tasks\")","+def tasks(db: Session = Depends(get_db), _: str = Depends(aktuell)):","+    return [{\"id\": t.id, \"agent\": t.agent_id, \"titel\": t.title, \"status\": t.status, \"ergebnis\": t.result} for t in db.query(models.Task).order_by(models.Task.created_at.desc()).limit(50)]","+@app.get(\"/api/v1/events\")","+def events(db: Session = Depends(get_db), _: str = Depends(aktuell)):","+    return [{\"id\": e.id, \"typ\": e.type, \"zeit\": str(e.created_at)} for e in db.query(models.Event).order_by(models.Event.created_at.desc()).limit(50)]","+","+class ProviderNeu(BaseModel):","+    provider_type: str; display_name: str; base_url: str; api_key: str = \"\"","+    default_model: str = \"\"; enabled: bool = True","+@app.get(\"/api/v1/providers\")","+def provider_liste(db: Session = Depends(get_db), _: str = Depends(aktuell)):","+    return [{\"id\": p.id, \"name\": p.display_name, \"typ\": p.provider_type, \"secret_gesetzt\": p.has_secret, \"aktiv\": p.enabled} for p in db.query(models.ModelProvider).all()]","+@app.post(\"/api/v1/providers\")","+def provider_anlegen(b: ProviderNeu, db: Session = Depends(get_db), _: str = Depends(aktuell)):","+    # Schlüssel nie im Klartext speichern/ausgeben – nur Referenz + Flag","+    p = models.ModelProvider(provider_type=b.provider_type, display_name=b.display_name, base_url=b.base_url,","+        api_key_ref=(\"secret:providers/\" + b.display_name) if b.api_key else \"\", has_secret=bool(b.api_key),","+        default_model=b.default_model, enabled=b.enabled)","+    db.add(p); db.commit(); return {\"id\": p.id, \"secret_gesetzt\": p.has_secret}","+","+class Standort(BaseModel): device_id: str; lat: float; lon: float; genauigkeit_m: float = 0","+@app.post(\"/api/v1/location\")","+def standort(b: Standort, db: Session = Depends(get_db), _: str = Depends(aktuell)):","+    ok, msg = sos_validieren(b.lat, b.lon)","+    if not ok: raise HTTPException(400, msg)","+    db.add(models.LocationSample(device_id=b.device_id, lat=b.lat, lon=b.lon, genauigkeit_m=b.genauigkeit_m)); db.commit()","+    return {\"gespeichert\": True}","+class Sos(BaseModel): device_id: str = \"\"; idempotency_key: str","+@app.post(\"/api/v1/safety/sos\")","+def sos(b: Sos, db: Session = Depends(get_db), _: str = Depends(aktuell)):","+    if db.query(models.SosEvent).filter_by(idempotency_key=b.idempotency_key).first():","+        return {\"status\": \"bereits_erfasst\", \"versand\": \"kein Doppelversand (idempotent)\"}","+    e = models.SosEvent(device_id=b.device_id, status=\"test\" if not settings.sos_delivery_enabled else \"ausgeloest\", idempotency_key=b.idempotency_key)","+    db.add(e); db.commit()","+    if not settings.sos_delivery_enabled:","+        return {\"status\": \"test\", \"hinweis\": \"Testmodus: Nachricht erzeugt, NICHT versendet.\"}","+    return {\"status\": \"ausgeloest\"}","+","+# Optionale OpenAI-Fassade (Standard: aus). Nutzt eigene API-Keys, keine Agentenumgehung.","+@app.get(\"/v1/models\")","+def fassaden_modelle(x_api_key: str = Header(default=\"\")):","+    if not settings.facade_enabled or x_api_key != settings.facade_api_key: raise HTTPException(404, \"Fassade deaktiviert\")","+    return {\"data\": [{\"id\": \"agentenprofil-standard\"}]}"]}]}]}
