{"files":[{"path":"\\\\?\\C:\\Users\\danie\\OneDrive\\github-repos\\Agentenplattform\\apps\\backend\\app\\services\\runner.py","hunks":[{"oldStart":88,"oldLines":12,"newStart":88,"newLines":42,"lines":["     db.add(models.Event(type=\"task.completed\", source=\"runner\", ref_id=task.id)); db.commit()","     return \"succeeded\""," ","-def _gateway_sync(gateway, text: str, profil: str):","+def _agent_durchlauf(gateway, definition, text: str, task, db, run):","+    \"\"\"Ein Agenten-Durchlauf: Systemprompt + Tools, serverseitig ausgeführt.","+","+    1. Gateway-Aufruf mit Systemprompt und erlaubten Tool-Schemas.","+    2. Tool-Calls des Modells werden serverseitig geprüft/ausgeführt (max_calls).","+    3. Zweiter Gateway-Aufruf fasst Tool-Ergebnisse zusammen.","+    \"\"\"","+    from app.tools.registry import TOOLS","+    from app.tools.executor import tool_ausfuehren","+    from app.providers.gateway import tool_schema_fuer","+    schemas = [tool_schema_fuer(t, TOOLS[t].beschreibung)","+               for t in (definition.tools or []) if t in TOOLS]","+    nachrichten = [ChatNachricht(rolle=\"system\", inhalt=definition.systemprompt or","+                                 \"Du bist ein hilfreicher Assistent. Antworte deutsch.\"),","+                   ChatNachricht(rolle=\"user\", inhalt=text)]","+    req = ChatAnfrage(nachrichten=nachrichten, tools=schemas)","+    antwort = _gateway_sync(gateway, req)","+    aufrufe = (antwort.tool_calls or [])[: (definition.max_calls or 10)]","+    if not aufrufe: return antwort","+    run.log += f\"\\nModell will {len(aufrufe)} Tool(s) nutzen.\"","+    for c in aufrufe:","+        args = dict(c.argumente or {}); args[\"_task_id\"] = task.id","+        ausgang = tool_ausfuehren(task.agent_id, c.name, args, db)","+        run.log += f\"\\nTool {c.name}: {'OK' if 'ergebnis' in ausgang else ausgang.get('fehler', '?')}\"","+        db.commit()","+        nachrichten.append(ChatNachricht(","+            rolle=\"tool\", inhalt=f\"Tool {c.name}: {ausgang.get('ergebnis', ausgang)}\",","+            tool_call_id=c.id))","+    req2 = ChatAnfrage(nachrichten=nachrichten)","+    return _gateway_sync(gateway, req2)","+","+def _gateway_sync(gateway, req):","     \"\"\"Ruft async-Gateway aus synchronem Worker auf.\"\"\"","     import asyncio","-    req = ChatAnfrage(nachrichten=[ChatNachricht(rolle=\"user\", inhalt=text)])","     try:","-        loop = asyncio.get_running_loop()","+        asyncio.get_running_loop()","     except RuntimeError:","         return asyncio.run(gateway.chat(req))","     import concurrent.futures"]}]}]}