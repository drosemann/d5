// {"files":[{"path":"\\\\?\\C:\\Users\\danie\\OneDrive\\github-repos\\Agentenplattform\\apps\\backend\\app\\main.py","hunks":[{"oldStart":228,"oldLines":6,"newStart":228,"newLines":27,"lines":["     if device_id: q = q.filter_by(device_id=device_id)","     return [{\"lat\": s.lat, \"lon\": s.lon, \"genau\": s.genauigkeit_m, \"zeit\": str(s.zeit)} for s in q]"," ","+# --- Runs (Protokoll der Agentenläufe) ---","+@app.get(\"/api/v1/runs\")","+def runs(task_id: str = \"\", db: Session = Depends(get_db), _: str = Depends(aktuell)):","+    q = db.query(models.AgentRun).order_by(models.AgentRun.created_at.desc()).limit(100)","+    if task_id: q = q.filter_by(task_id=task_id)","+    return [{\"id\": r.id, \"task\": r.task_id, \"agent\": r.agent_id, \"status\": r.status,","+             \"dauer_ms\": r.duration_ms} for r in q]","+","+# --- Einstellungen (System, Schlüssel/Wert) ---","+@app.get(\"/api/v1/settings\")","+def settings_lesen(db: Session = Depends(get_db), _: str = Depends(aktuell)):","+    return {s.key: s.value for s in db.query(models.SystemSetting).all()}","+class SettingNeu(BaseModel): key: str; value: dict","+@app.put(\"/api/v1/settings/{key}\")","+def setting_setzen(key: str, b: SettingNeu, db: Session = Depends(get_db), user: str = Depends(aktuell)):","+    s = db.query(models.SystemSetting).filter_by(key=key).first()","+    if s is None: s = models.SystemSetting(key=key, value=b.value); db.add(s)","+    else: s.value = b.value","+    db.add(models.AuditLog(actor=user, aktion=\"setting.set\", detail=key)); db.commit()","+    return {\"key\": key}","+"," # --- Eigene API-Schlüssel (nur Hash gespeichert, Klartext einmalig) ---"," class KeyNeu(BaseModel): name: str"," @app.get(\"/api/v1/api-keys\")"]}]}]}
