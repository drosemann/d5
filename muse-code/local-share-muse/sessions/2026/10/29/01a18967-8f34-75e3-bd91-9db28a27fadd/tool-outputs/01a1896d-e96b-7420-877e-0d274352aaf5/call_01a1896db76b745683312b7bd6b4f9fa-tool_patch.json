{"files":[{"path":"\\\\?\\C:\\Users\\danie\\OneDrive\\github-repos\\Agentenplattform\\apps\\frontend\\src\\seiten.tsx","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":48,"lines":["+import React, { useEffect, useState } from \"react\";","+import \"./styles.css\";","+import { Layout } from \"./app\";","+","+type Aufgabe = { id: string; agent: string; titel: string; status: string };","+","+function useJson<T>(url: string, fallback: T): T {","+  const [d, setD] = useState<T>(fallback);","+  useEffect(() => { fetch(url).then(r => r.json()).then(setD).catch(() => {}); }, [url]);","+  return d;","+}","+const DemoHinweis = () => <p style={{color:\"var(--muted)\"}}>Demo-Daten sind sichtbar als Beispiel gekennzeichnet.</p>;","+const Dashboard = () => {","+  const tasks = useJson<Aufgabe[]>(\"/api/v1/tasks\", []);","+  return (<><h2>Willkommen – Tagesstatus</h2><DemoHinweis/>","+    <div className=\"kachel-raster\">","+      <div className=\"kachel\"><h2>Offene Aufgaben</h2><p>{tasks.filter(t=>[\"pending\",\"queued\",\"running\"].includes(t.status)).length}</p></div>","+      <div className=\"kachel\"><h2>Letzte Läufe</h2><p>{tasks.length}</p></div>","+      <div className=\"kachel\"><h2>System</h2><p>Siehe Einstellungen → Diagnose</p></div>","+    </div></>);","+};","+const Agenten = () => {","+  const a = useJson<{id:string;name:string;beschreibung:string}[]>(\"/api/v1/agents\", []);","+  return (<><h2>Agenten</h2><div className=\"kachel-raster\">{a.map(x=><div className=\"kachel\" key={x.id}><h2>{x.name}</h2><p>{x.beschreibung}</p></div>)}</div></>);","+};","+const Chat = () => {","+  const [titel, setTitel] = useState(\"\"); const [msg, setMsg] = useState(\"\");","+  const senden = async () => {","+    const r = await fetch(\"/api/v1/tasks\", {method:\"POST\", headers:{\"Content-Type\":\"application/json\"}, body:JSON.stringify({titel, eingabe:{text:titel}} )});","+    setMsg(r.ok ? \"Auftrag angelegt.\" : \"Fehler: Auftrag abgelehnt – Details in Aufgabenliste.\");","+  };","+  return (<><h2>Chat & Aufgaben</h2><input aria-label=\"Auftrag\" value={titel} onChange={e=>setTitel(e.target.value)} placeholder=\"z. B. Plane meinen Dienstag mit Gym\" style={{width:\"100%\",padding:12}}/>","+    <p><button className=\"knopf fokus-sichtbar\" onClick={senden}>Senden (Abbrechen in Liste möglich)</button></p><p>{msg}</p></>);","+};","+const Angebote = () => (<><h2>Angebote</h2><DemoHinweis/><div className=\"kachel\"><h2>Demo-Inserat (Beispiel)</h2><p>2-Zimmer · 650 € · Abruf: Demo-Adapter, heute</p></div></>);","+const Sicherheit = () => {","+  const [msg, setMsg] = useState(\"\");","+  const sos = async (echt:boolean) => {","+    if (echt && !confirm(\"Wirklich SOS auslösen?\")) return;","+    const r = await fetch(\"/api/v1/safety/sos\", {method:\"POST\", headers:{\"Content-Type\":\"application/json\"}, body:JSON.stringify({idempotency_key:crypto.randomUUID()})});","+    const d = await r.json(); setMsg(d.hinweis ?? d.status);","+  };","+  return (<><h2>Standort & SOS</h2><p>Letzte Position: Demo-Spur · vor 10 Min · synchronisiert</p>","+    <p><button className=\"knopf fokus-sichtbar\" onClick={()=>sos(false)}>Testalarm (kein Versand)</button> <button className=\"knopf gefahr fokus-sichtbar\" onClick={()=>sos(true)}>SOS</button></p><p>{msg}</p></>);","+};","+const Freigaben = () => (<><h2>Freigaben</h2><p>Keine ausstehenden Aktionen (Demo).</p></>);","+const Einstellungen = () => (<><h2>Einstellungen</h2><p>Provider, E-Mail, Aufbewahrung, Kontakte – Schlüssel werden nie im Klartext angezeigt.</p></>);","+export const seiten = { Dashboard, Agenten, Chat, Angebote, Sicherheit, Freigaben, Einstellungen };"]}]}]}