// {"files":[{"path":"\\\\?\\C:\\Users\\danie\\OneDrive\\github-repos\\Agentenplattform\\apps\\frontend\\src\\styles.css","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":22,"lines":["+/* Leitstand-Raster: dunkles Raster, Cyan-Akzent, Magenta-Rahmen (wie Icon). */","+:root { --bg:#0b0b0f; --raster:#1c1c26; --tinte:#f4f4f5; --muted:#a1a1aa; --cyan:#2bb8cf; --magenta:#d000c0; --karte:#13131b; }","+* { box-sizing:border-box; }","+body { margin:0; background:var(--bg); color:var(--tinte); font-family:\"Segoe UI\",system-ui,sans-serif;","+  background-image:linear-gradient(var(--raster) 1px,transparent 1px),linear-gradient(90deg,var(--raster) 1px,transparent 1px);","+  background-size:44px 44px; }","+a { color:var(--cyan); }","+.layout { display:grid; grid-template-columns:250px 1fr; min-height:100vh; }","+.seite { border-right:4px solid var(--magenta); background:#0e0e14; padding:20px; }","+.seite h1 { font-size:20px; margin:0 0 4px; }","+.seite nav { display:grid; gap:8px; margin-top:16px; }","+.seite nav a { padding:10px 12px; border:1px solid var(--raster); border-radius:10px; text-decoration:none; color:var(--tinte); }","+.seite nav a:hover,.seite nav a:focus-visible { border-color:var(--cyan); outline:2px solid var(--cyan); }","+.inhalt { padding:28px; max-width:1100px; }","+.kachel-raster { display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:16px; }","+.kachel { background:var(--karte); border:1px solid var(--raster); border-left:6px solid var(--cyan); border-radius:12px; padding:16px; }","+.kachel h2 { margin:0 0 8px; font-size:18px; }","+.knopf { background:var(--cyan); color:#04252b; border:0; border-radius:10px; padding:12px 16px; font-weight:700; min-height:44px; cursor:pointer; }","+.knopf.gefahr { background:#e11d48; color:#fff; min-height:56px; font-size:18px; }","+.fokus-sichtbar:focus-visible { outline:3px solid var(--magenta); outline-offset:2px; }","+@media (max-width:800px){ .layout{grid-template-columns:1fr;} .seite{border-right:0;border-bottom:4px solid var(--magenta);} }","+@media (prefers-reduced-motion:reduce){ *{animation:none!important;transition:none!important;} }"]}]}]}
