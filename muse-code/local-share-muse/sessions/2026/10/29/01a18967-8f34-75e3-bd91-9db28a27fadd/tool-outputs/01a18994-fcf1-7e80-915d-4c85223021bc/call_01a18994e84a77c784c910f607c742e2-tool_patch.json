{"files":[{"path":"\\\\?\\C:\\Users\\danie\\OneDrive\\github-repos\\Agentenplattform\\apps\\backend\\tests\\test_kern.py","hunks":[{"oldStart":72,"oldLines":3,"newStart":72,"newLines":30,"lines":["     from app.providers.gateway import tool_schema_fuer","     s = tool_schema_fuer(\"docs.suchen\", \"Suche\")","     assert s[\"function\"][\"name\"] == \"docs.suchen\"","+","+def test_versand_standard_aus():","+    from app.services import versand","+    ok, _ = versand.mailversand_bereit()","+    assert not ok  # Standard: kein echter Versand","+    ok, _ = versand.push_bereit()","+    assert not ok","+","+def test_coding_braucht_freigabe():","+    from app.services.coding import auftrag_vorbereiten","+    erg = auftrag_vorbereiten(\"Test\", \"diff\", freigegeben=False)","+    assert erg[\"status\"] == \"freigabe_noetig\"","+","+def test_kalender_tool_validierung():","+    from app.tools.registry import darf_tool","+    # planner darf kalender.eintragen nur mit Freigabe","+    ok, _ = darf_tool(\"planner\", \"kalender.eintragen\", False)","+    assert not ok","+    ok, _ = darf_tool(\"planner\", \"kalender.eintragen\", True)","+    assert ok","+    ok, _ = darf_tool(\"finance\", \"kalender.eintragen\", True)","+    assert not ok  # falscher Agent","+","+def test_verkehr_demo_braucht_db_nicht():","+    from app.services.mail import praefix_erkennen","+    assert praefix_erkennen(\"@finance Bericht\", \"\") == \"finance\"","+    assert praefix_erkennen(\"Hallo Welt\", \"\") is None"]}]}]}