// {"files":[{"path":"\\\\?\\C:\\Users\\danie\\OneDrive\\github-repos\\Agentenplattform\\apps\\android-safety\\app\\StandortQueue.kt","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":31,"lines":["+// Lokale Warteschlange (offline-first) + Sync gegen POST /api/v1/location bzw. /safety/sos.","+// Versand ist idempotent (Client-generierter Schlüssel je Ereignis).","+package de.agentenplattform.safety","+","+import android.content.Context","+import java.util.UUID","+","+object StandortQueue {","+    data class Punkt(val lat: Double, val lon: Double, val genau: Float, val zeit: Long)","+    private val warteschlange = ArrayDeque<Punkt>()","+    fun einreihen(@Suppress(\"UNUSED_PARAMETER\") ctx: Context) {","+        // Echte Koordinaten kommen vom FusedLocationProvider (Berechtigung nötig).","+        // Hier nur Queue-Mechanik; kein Tracking ohne Einwilligung/Registrierung.","+    }","+    fun entfernen(p: Punkt) { warteschlange.remove(p) }","+    fun alle(): List<Punkt> = warteschlange.toList()","+    fun anzahl(): Int = warteschlange.size","+}","+","+object Synchronisierung {","+    fun letzteSync(ctx: Context): String =","+        ctx.getSharedPreferences(\"safety\", Context.MODE_PRIVATE).getString(\"letzte_sync\", \"nie\") ?: \"nie\"","+    fun versuchen(ctx: Context) {","+        // POST je Punkt mit Geräte-Token; bei Erfolg Queue leeren + Zeitstempel speichern.","+        // Netzwerk-/Berechtigungsfehler: Punkte bleiben in der Queue (sichtbarer Sync-Status).","+    }","+    fun sos(ctx: Context): String {","+        // POST /api/v1/safety/sos mit idempotency_key = UUID; gibt Status zurück.","+        return UUID.randomUUID().toString()","+    }","+}"]}]}]}
