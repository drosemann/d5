// {"files":[{"path":"\\\\?\\C:\\Users\\danie\\OneDrive\\github-repos\\Agentenplattform\\apps\\backend\\app\\main.py","hunks":[{"oldStart":114,"oldLines":6,"newStart":114,"newLines":44,"lines":["     from app.services.planung import tagesplan_bauen","     return tagesplan_bauen(db)"," ","+# --- Modell-Gateway-Verwaltung ---","+class ProfilNeu(BaseModel):","+    agent_id: str; provider_id: str; modell: str = \"\"","+    temperatur: float = 0.3; max_tokens: int = 800; timeout_s: int = 60; fallback_modell: str = \"\"","+@app.get(\"/api/v1/model-profiles\")","+def profile_liste(db: Session = Depends(get_db), _: str = Depends(aktuell)):","+    return [{\"agent_id\": m.agent_id, \"provider_id\": m.provider_id, \"modell\": m.modell,","+             \"temperatur\": m.temperatur, \"max_tokens\": m.max_tokens} for m in db.query(models.ModelProfile).all()]","+@app.put(\"/api/v1/model-profiles/{agent_id}\")","+def profil_setzen(agent_id: str, b: ProfilNeu, db: Session = Depends(get_db), _: str = Depends(aktuell)):","+    m = db.query(models.ModelProfile).filter_by(agent_id=agent_id).first()","+    if m is None: m = models.ModelProfile(agent_id=agent_id, provider_id=b.provider_id); db.add(m)","+    m.provider_id = b.provider_id; m.modell = b.modell; m.temperatur = b.temperatur","+    m.max_tokens = b.max_tokens; m.timeout_s = b.timeout_s; m.fallback_modell = b.fallback_modell","+    db.commit(); return {\"agent_id\": m.agent_id, \"modell\": m.modell}","+@app.get(\"/api/v1/providers/{pid}/models\")","+def provider_modelle(pid: str, db: Session = Depends(get_db), _: str = Depends(aktuell)):","+    import asyncio, os","+    from app.providers.gateway import OpenAIKompatibelProvider","+    p = db.query(models.ModelProvider).filter_by(id=pid).first()","+    if p is None: raise HTTPException(404, \"Provider unbekannt\")","+    gw = OpenAIKompatibelProvider(p.base_url, os.environ.get(\"PROVIDER_API_KEY\", \"\"), p.default_model, 15)","+    try: modelle = asyncio.run(gw.list_models())","+    except Exception as e: raise HTTPException(502, f\"Modellliste nicht abrufbar: {e}\")","+    return [{\"id\": m.id} for m in modelle]","+@app.post(\"/api/v1/providers/{pid}/test\")","+def provider_test(pid: str, db: Session = Depends(get_db), _: str = Depends(aktuell)):","+    import asyncio, os","+    from app.providers.gateway import OpenAIKompatibelProvider","+    p = db.query(models.ModelProvider).filter_by(id=pid).first()","+    if p is None: raise HTTPException(404, \"Provider unbekannt\")","+    gw = OpenAIKompatibelProvider(p.base_url, os.environ.get(\"PROVIDER_API_KEY\", \"\"), p.default_model, 15)","+    status = asyncio.run(gw.healthcheck())","+    db.add(models.Event(type=\"provider.tested\" if status.ok else \"agent.failed\",","+                        source=\"api\", ref_id=pid, payload={\"detail\": status.detail}))","+    db.commit()","+    return {\"ok\": status.ok, \"detail\": status.detail}","+"," # Optionale OpenAI-Fassade (Standard: aus). Nutzt eigene API-Keys, keine Agentenumgehung."," @app.get(\"/v1/models\")"," def fassaden_modelle(x_api_key: str = Header(default=\"\")):"]}]}]}
