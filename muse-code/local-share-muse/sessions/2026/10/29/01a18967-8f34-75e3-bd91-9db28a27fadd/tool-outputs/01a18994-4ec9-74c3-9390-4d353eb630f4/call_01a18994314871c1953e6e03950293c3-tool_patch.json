{"files":[{"path":"\\\\?\\C:\\Users\\danie\\OneDrive\\github-repos\\Agentenplattform\\apps\\frontend\\src\\seiten.tsx","hunks":[{"oldStart":60,"oldLines":7,"newStart":60,"newLines":39,"lines":["   return (<><h2>Standort & SOS</h2><p>Letzte Position: Demo-Spur · vor 10 Min · synchronisiert</p>","     <p><button className=\"knopf fokus-sichtbar\" onClick={()=>sos(false)}>Testalarm (kein Versand)</button> <button className=\"knopf gefahr fokus-sichtbar\" onClick={()=>sos(true)}>SOS</button></p><p>{msg}</p></>);"," };","-const Freigaben = () => (<><h2>Freigaben</h2><p>Keine ausstehenden Aktionen (Demo).</p></>);","+type Termin = { id: string; titel: string; beginn: string; ende: string; fix: boolean };","+const Kalender = () => {","+  const [termine, setTermine] = useState<Termin[]>([]);","+  const [t, setT] = useState({titel:\"\", beginn:\"\", ende:\"\"});","+  const laden = () => { fetch(\"/api/v1/calendar\").then(r=>r.json()).then(setTermine).catch(()=>{}); };","+  useEffect(laden, []);","+  const speichern = async () => {","+    const r = await fetch(\"/api/v1/calendar\", {method:\"POST\", headers:{\"Content-Type\":\"application/json\"}, body:JSON.stringify(t)});","+    if (r.ok) { setT({titel:\"\", beginn:\"\", ende:\"\"}); laden(); }","+  };","+  return (<><h2>Kalender</h2>","+    <div className=\"kachel\"><h2>Neuer Termin</h2>","+      <input aria-label=\"Titel\" placeholder=\"Titel\" value={t.titel} onChange={e=>setT({...t, titel:e.target.value})} style={{width:\"100%\",padding:10,marginBottom:8}}/>","+      <input aria-label=\"Beginn\" type=\"datetime-local\" value={t.beginn} onChange={e=>setT({...t, beginn:e.target.value})} style={{width:\"100%\",padding:10,marginBottom:8}}/>","+      <input aria-label=\"Ende\" type=\"datetime-local\" value={t.ende} onChange={e=>setT({...t, ende:e.target.value})} style={{width:\"100%\",padding:10,marginBottom:8}}/>","+      <p><button className=\"knopf fokus-sichtbar\" onClick={speichern}>Eintragen</button></p></div>","+    <div className=\"kachel-raster\">{termine.map(x=><div className=\"kachel\" key={x.id}><h2>{x.titel}</h2><p>{x.beginn} → {x.ende}{x.fix ? \" (fix)\" : \"\"}</p></div>)}</div></>);","+};","+type Freigabe = { id: string; task: string; zweck: string; status: string };","+const Freigaben = () => {","+  const [liste, setListe] = useState<Freigabe[]>([]);","+  const laden = () => { fetch(\"/api/v1/approvals\").then(r=>r.json()).then(setListe).catch(()=>{}); };","+  useEffect(laden, []);","+  const entscheiden = async (id: string, genehmigt: boolean) => {","+    await fetch(`/api/v1/approvals/${id}`, {method:\"POST\", headers:{\"Content-Type\":\"application/json\"}, body:JSON.stringify({genehmigt})});","+    laden();","+  };","+  const offen = liste.filter(f=>f.status===\"offen\");","+  return (<><h2>Freigaben</h2>","+    {offen.length === 0 && <p>Keine ausstehenden Aktionen.</p>}","+    <div className=\"kachel-raster\">{offen.map(f=><div className=\"kachel\" key={f.id}><h2>{f.zweck}</h2>","+      <p><button className=\"knopf fokus-sichtbar\" onClick={()=>entscheiden(f.id, true)}>Genehmigen</button> <button className=\"knopf fokus-sichtbar\" onClick={()=>entscheiden(f.id, false)}>Ablehnen</button></p></div>)}</div></>);","+};"," const Einstellungen = () => {","   const status = useJson<any>(\"/api/v1/system/status\", null);","   return (<><h2>Einstellungen</h2>"]}]}]}