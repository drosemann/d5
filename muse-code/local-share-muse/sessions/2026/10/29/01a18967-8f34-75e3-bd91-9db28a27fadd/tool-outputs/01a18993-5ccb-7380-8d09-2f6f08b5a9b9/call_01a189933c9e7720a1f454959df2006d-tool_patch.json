{"files":[{"path":"\\\\?\\C:\\Users\\danie\\OneDrive\\github-repos\\Agentenplattform\\apps\\backend\\app\\main.py","hunks":[{"oldStart":268,"oldLines":6,"newStart":268,"newLines":54,"lines":["     feeds = b.feeds or [os.environ[\"TECHNEWS_FEEDS\"].split(\",\")[0]] if os.environ.get(\"TECHNEWS_FEEDS\") else []","     return technews_import(db, feeds)"," ","+# --- Kalender (Lesen/Schreiben; Agenten nur mit Freigabe-Tool) ---","+class TerminNeu(BaseModel): titel: str; beginn: str; ende: str; fix: bool = False","+@app.get(\"/api/v1/calendar\")","+def kalender(db: Session = Depends(get_db), _: str = Depends(aktuell)):","+    return [{\"id\": c.id, \"titel\": c.titel, \"beginn\": str(c.beginn), \"ende\": str(c.ende), \"fix\": c.fix}","+            for c in db.query(models.CalendarItem).order_by(models.CalendarItem.beginn.desc()).limit(200)]","+@app.post(\"/api/v1/calendar\")","+def termin_anlegen(b: TerminNeu, db: Session = Depends(get_db), user: str = Depends(aktuell)):","+    from datetime import datetime","+    try: beginn, ende = datetime.fromisoformat(b.beginn), datetime.fromisoformat(b.ende)","+    except ValueError: raise HTTPException(400, \"ISO-Datum erwartet (z. B. 2026-11-02T09:00).\")","+    if ende <= beginn: raise HTTPException(400, \"Ende muss nach Beginn liegen.\")","+    c = models.CalendarItem(titel=b.titel[:200], beginn=beginn, ende=ende, fix=b.fix)","+    db.add(c); db.add(models.AuditLog(actor=user, aktion=\"calendar.create\", detail=b.titel[:200])); db.commit()","+    return {\"id\": c.id}","+@app.delete(\"/api/v1/calendar/{cid}\")","+def termin_loeschen(cid: str, db: Session = Depends(get_db), user: str = Depends(aktuell)):","+    c = db.query(models.CalendarItem).filter_by(id=cid).first()","+    if c is None: raise HTTPException(404, \"Termin unbekannt\")","+    db.delete(c); db.add(models.AuditLog(actor=user, aktion=\"calendar.delete\", detail=cid)); db.commit()","+    return {\"geloescht\": cid}","+","+# --- Coding-Aufträge (Workspace, Freigabe-Pflicht) ---","+class CodingBitte(BaseModel): beschreibung: str; patch: str = \"\"; approval_id: str | None = None","+@app.post(\"/api/v1/coding/prepare\")","+def coding_prepare(b: CodingBitte, db: Session = Depends(get_db), user: str = Depends(aktuell)):","+    from app.services.coding import auftrag_vorbereiten","+    freigegeben = False","+    if b.approval_id:","+        a = db.query(models.Approval).filter_by(id=b.approval_id).first()","+        freigegeben = bool(a and a.status == \"genehmigt\")","+    ausgang = auftrag_vorbereiten(b.beschreibung, b.patch, freigegeben)","+    db.add(models.AuditLog(actor=user, aktion=\"coding.prepare\", detail=str(ausgang.get(\"status\")))); db.commit()","+    if ausgang.get(\"status\") == \"freigabe_noetig\":","+        ap = models.Approval(task_id=\"\", zweck=f\"Coding: {b.beschreibung[:200]}\")","+        db.add(ap); db.commit(); ausgang[\"approval_id\"] = ap.id","+    return ausgang","+","+# --- Mail-Abruf + Versandsteuerung ---","+@app.post(\"/api/v1/mail/fetch\")","+def mail_fetch(db: Session = Depends(get_db), _: str = Depends(aktuell)):","+    from app.services.mail_eingang import abruf_einmal","+    return abruf_einmal(db)","+@app.post(\"/api/v1/notifications/dispatch\")","+def notif_dispatch(db: Session = Depends(get_db), _: str = Depends(aktuell)):","+    from app.services.versand import ausstehende_versenden","+    return ausstehende_versenden(db)","+"," # --- Eigene API-Schlüssel (nur Hash gespeichert, Klartext einmalig) ---"," class KeyNeu(BaseModel): name: str"," @app.get(\"/api/v1/api-keys\")"]}]}]}