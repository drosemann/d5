// {"files":[{"path":"\\\\?\\C:\\Users\\danie\\OneDrive\\github-repos\\Agentenplattform\\apps\\backend\\app\\services\\mail.py","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":24,"lines":["+\"\"\"E-Mail-Eingang: ein Postfach, Absenderprüfung, Demo-/Testmodus.\"\"\"","+import re","+from app.core.config import settings","+","+def normalisiere_absender(raw: str) -> str:","+    \"\"\"Schützt vor Anzeigenamen-Tricks: nutzt letzte <addr> bzw. plain.\"\"\"","+    m = re.search(r\"<([^>]+)>\", raw or \"\")","+    addr = (m.group(1) if m else (raw or \"\")).strip().lower()","+    return addr","+","+def absender_erlaubt(raw_from: str) -> bool:","+    return normalisiere_absender(raw_from) == settings.allowed_email_sender.lower()","+","+def praefix_erkennen(betreff: str, text: str) -> str | None:","+    \"\"\"Explizite Präfixe wie @finance, @youtube, @planner.\"\"\"","+    for p in [\"@finance\", \"@youtube\", \"@planner\", \"@safety\", \"@health\"]:","+        if p in (betreff + \" \" + text).lower(): return p.lstrip(\"@\")","+    return None","+","+def anhang_geprueft(dateiname: str, groesse: int, erlaube=(\"pdf\",\"csv\",\"png\",\"jpg\",\"txt\",\"json\")) -> tuple[bool,str]:","+    end = dateiname.rsplit(\".\",1)[-1].lower() if \".\" in dateiname else \"\"","+    if end not in erlaube: return False, f\"Dateityp .{end} abgelehnt\"","+    if groesse > 15*1024*1024: return False, \"Anhang zu groß (max. 15 MB)\"","+    return True, \"ok\""]}]}]}
