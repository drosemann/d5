object):  # Platzhalter-Typ, echte Signatur unten","+    pass","+","+class _ProviderProtokoll:","+    async def chat(self, req: ChatAnfrage) -> ChatAntwort: raise NotImplementedError","+    async def healthcheck(self) -> ProviderStatus: raise NotImplementedError","+    async def list_models(self) -> list[ModellInfo]: raise NotImplementedError"," ","-class OpenAIKompatibelProvider:","+def tool_schema_fuer(tool_id: str, beschreibung: str) -> dict:","+    \"\"\"Erzeugt ein generisches Function-Schema (offene Argumente, Server validiert).\"\"\"","+    return {\"type\": \"function\", \"function\": {\"name\": tool_id, \"description\": beschreibung,","+            \"parameters\": {\"type\": \"object\", \"properties\": {","+                \"query\": {\"type\": \"string\"}, \"profil_id\": {\"type\": \"string\"},","+                \"url\": {\"type\": \"string\"}, \"max_preis\": {\"type\": \"number\"},","+                \"quelle\": {\"type\": \"string\"}, \"feed_url\": {\"type\": \"string\"}}}}}","+","+class OpenAIKompatibelProvider(_ProviderProtokoll):","     \"\"\"Spricht Ollama (/v1), OpenAI und kompatible Endpunkte via Chat-Completions.\"\"\"","     def __init__(self, base_url: str, api_key: str, modell: str, timeout: int = 60):","         self.base_url, self.api_key, self.modell, self.timeout = base_url.rstrip(\"/\"), api_key, modell, timeout","+    def _headers(self): return {\"Authorization\": f\"Bearer {self.api_key}\"}","     async def chat(self, req: ChatAnfrage) -> ChatAntwort:","-        url = f\"{self.base_url}/chat/completions\"","-        body = {\"model\": req.modell or self.modell,","+        body: dict = {\"model\": req.modell or self.modell,","                 \"messages\": [{\"role\": n.rolle, \"content\": n.inhalt} for n in req.nachrichten],","                 \"temperature\": req.temperatur, \"max_tokens\": req.max_tokens}","+        if req.tools: body[\"tools\"] = req.tools","+        if req.json_modus: body[\"response_format\"] = {\"type\": \"json_object\"}","         try:","             async with httpx.AsyncClient(timeout=req.timeout or self.timeout) as c:","-                r = await c.post(url, json=body, headers={\"Authorization\": f\"Bearer {self.api_key}\"})","+                r = await c.post(f\"{self.base_url}/chat/completions\", json=body, headers=self._headers())","                 r.raise_for_status(); d = r.json()","-            msg = d[\"choices\"][0][\"message\"][\"content\"]","-            u = d.get(\"usage\", {})","-            return ChatAntwort(text=msg, modell=d.get(\"model\", \"\"), prompt_tokens=u.get(\"prompt_tokens\", 0), completion_tokens=u.get(\"completion_tokens\", 0))","         except Exception as e:","             raise RuntimeError(f\"Providerfehler ({self.base_url}): {e}\") from e","+        msg = d[\"choices\"][0][\"message\"]","+        calls = [ToolAufruf(id=t.get(\"id\", str(i)), name=t[\"function\"][\"name\"],","+                            argumente=_json_sicher(t[\"function\"].get(\"arguments\", \"{}\")))","+                 for i, t in enumerate(msg.get(\"tool_calls\", []) or [])]","+        u = d.get(\"usage\", {})","+        return ChatAntwort(text=msg.get(\"content\") or \"\", modell=d.get(\"model\", \"\"),","+                           tool_calls=calls, prompt_tokens=u.get(\"prompt_tokens\", 0),","+                           completion_tokens=u.get(\"completion_tokens\", 0))","     async def healthcheck(self) -> ProviderStatus:","         try:","             async with httpx.AsyncClient(timeout=10) as c:","-                r = await c.get(f\"{self.base_url}/models\", headers={\"Authorization\": f\"Bearer {self.api_key}\"})","+                r = await c.get(f\"{self.base_url}/models\", headers=self._headers())","                 return ProviderStatus(ok=r.status_code < 500, detail=f\"HTTP {r.status_code}\")","         except Exception as e: return ProviderStatus(ok=False, detail=str(e))","+    async def list_models(self) -> list[ModellInfo]:","+        try:","+            async with httpx.AsyncClient(timeout=15) as c:","+                r = await c.get(f\"{self.base_url}/models\", headers=self._headers())","+                r.raise_for_status(); d = r.json()","+            return [ModellInfo(id=m.get(\"id\", \"\")) for m in d.get(\"data\", []) if m.get(\"id\")]","+        except Exception as e:","+            raise RuntimeError(f\"Modellliste nicht verfügbar ({self.base_url}): {e}\") from e"," ","-class MockProvider:","+def _json_sicher(s: str) -> dict:","+    import json","+    try: return json.loads(s) if isinstance(s, str) else dict(s)","+    except Exception: return {}","+","+class MockProvider(_ProviderProtokoll):","     \"\"\"Deterministischer Demo-Provider für Tests/Demo ohne echte Modelle.\"\"\"","     async def chat(self, req: ChatAnfrage) -> ChatAntwort:","         letzte = req.nachrichten[-1].inhalt if req.nachrichten else \"\"","         return ChatAntwort(text=f\"[Demo-Antwort] Eingabe verstanden ({len(letzte)} Zeichen). Echter Provider ist deaktiviert.\", modell=\"mock\")","     async def healthcheck(self) -> ProviderStatus: return ProviderStatus(ok=True, detail=\"Mock aktiv\")","+    async def list_models(self) -> list[ModellInfo]: return [ModellInfo(id=\"mock-demo\")]"]}]}]}
