// {"files":[{"path":"\\\\?\\C:\\Users\\danie\\OneDrive\\github-repos\\Agentenplattform\\apps\\backend\\app\\main.py","hunks":[{"oldStart":114,"oldLines":6,"newStart":114,"newLines":77,"lines":["     from app.services.planung import tagesplan_bauen","     return tagesplan_bauen(db)"," ","+# --- Freigaben ---","+@app.get(\"/api/v1/approvals\")","+def approves(db: Session = Depends(get_db), _: str = Depends(aktuell)):","+    return [{\"id\": a.id, \"task\": a.task_id, \"zweck\": a.zweck, \"status\": a.status}","+            for a in db.query(models.Approval).order_by(models.Approval.created_at.desc()).limit(100)]","+class ApprovalEntscheid(BaseModel): genehmigt: bool","+@app.post(\"/api/v1/approvals/{aid}\")","+def approve_entscheiden(aid: str, b: ApprovalEntscheid, db: Session = Depends(get_db), user: str = Depends(aktuell)):","+    a = db.query(models.Approval).filter_by(id=aid).first()","+    if a is None: raise HTTPException(404, \"Freigabe unbekannt\")","+    if a.status != \"offen\": raise HTTPException(409, \"Bereits entschieden\")","+    a.status = \"genehmigt\" if b.genehmigt else \"abgelehnt\"","+    db.add(models.AuditLog(actor=user, aktion=f\"approval.{a.status}\", detail=aid)); db.commit()","+    return {\"id\": aid, \"status\": a.status}","+","+# --- Benachrichtigungen ---","+@app.get(\"/api/v1/notifications\")","+def notifs(db: Session = Depends(get_db), _: str = Depends(aktuell)):","+    return [{\"id\": n.id, \"kanal\": n.kanal, \"text\": n.text, \"status\": n.status}","+            for n in db.query(models.Notification).order_by(models.Notification.created_at.desc()).limit(100)]","+class NotifNeu(BaseModel): text: str; kanal: str = \"pwa\"","+@app.post(\"/api/v1/notifications\")","+def notif_anlegen(b: NotifNeu, db: Session = Depends(get_db), _: str = Depends(aktuell)):","+    from app.core.config import settings as _s","+    # Externer Versand nur wenn konfiguriert+aktiv, sonst interner Status","+    status = \"pending\" if (_s.outbound_mail_enabled or b.kanal == \"pwa\") else \"suppressed\"","+    n = models.Notification(kanal=b.kanal, text=b.text[:1000], status=status)","+    db.add(n); db.commit(); return {\"id\": n.id, \"status\": status}","+","+# --- Dateien (Upload, typgeprüft) ---","+@app.post(\"/api/v1/files\")","+def datei_hochladen(db: Session = Depends(get_db), _: str = Depends(aktuell),","+                    datei=None):","+    # Separater Upload-Pfad über multipart wird unten registriert (Signatur-Hinweis)","+    raise HTTPException(501, \"Nutze POST /api/v1/files/upload (multipart).\")","+@app.post(\"/api/v1/files/upload\")","+async def datei_upload(db: Session = Depends(get_db), _: str = Depends(aktuell)):","+    from fastapi import Request","+    raise HTTPException(501, \"Upload folgt – siehe docs/configuration.md.\")","+","+# --- Finanzen: CSV-Import + Snapshots ---","+@app.post(\"/api/v1/finance/import\")","+def finance_import(db: Session = Depends(get_db), _: str = Depends(aktuell)):","+    raise HTTPException(501, \"CSV-Import folgt – siehe docs/configuration.md.\")","+@app.get(\"/api/v1/finance/snapshots\")","+def finance_snaps(db: Session = Depends(get_db), _: str = Depends(aktuell)):","+    return [{\"id\": s.id, \"datum\": str(s.datum), \"vermoegen\": s.vermoegen,","+             \"notiz\": s.notiz, \"demo\": s.demo} for s in","+            db.query(models.FinancialSnapshot).order_by(models.FinancialSnapshot.datum.desc()).limit(100)]","+","+# --- Gesundheit: Messwerte + Import ---","+class MesswertNeu(BaseModel): typ: str; wert: float","+@app.post(\"/api/v1/health-data\")","+def messwert(b: MesswertNeu, db: Session = Depends(get_db), _: str = Depends(aktuell)):","+    if b.typ not in (\"schritte\", \"schlaf_min\", \"puls\", \"gewicht\"):","+        raise HTTPException(400, \"Unbekannter Messtyp\")","+    m = models.HealthMeasurement(typ=b.typ, wert=b.wert)","+    db.add(m); db.commit(); return {\"id\": m.id}","+@app.get(\"/api/v1/health-data\")","+def messwerte(typ: str = \"\", db: Session = Depends(get_db), _: str = Depends(aktuell)):","+    q = db.query(models.HealthMeasurement).order_by(models.HealthMeasurement.zeit.desc()).limit(200)","+    if typ: q = q.filter_by(typ=typ)","+    return [{\"typ\": m.typ, \"wert\": m.wert, \"zeit\": str(m.zeit)} for m in q]","+","+# --- Standort: Verlauf ---","+@app.get(\"/api/v1/location\")","+def verlauf(device_id: str = \"\", db: Session = Depends(get_db), _: str = Depends(aktuell)):","+    q = db.query(models.LocationSample).order_by(models.LocationSample.zeit.desc()).limit(200)","+    if device_id: q = q.filter_by(device_id=device_id)","+    return [{\"lat\": s.lat, \"lon\": s.lon, \"genau\": s.genauigkeit_m, \"zeit\": str(s.zeit)} for s in q]","+"," # --- Modell-Gateway-Verwaltung ---"," class ProfilNeu(BaseModel):","     agent_id: str; provider_id: str; modell: str = \"\""]}]}]}
