{"files":[{"path":"\\\\?\\C:\\Users\\danie\\OneDrive\\github-repos\\Agentenplattform\\apps\\backend\\tests\\test_kern.py","hunks":[{"oldStart":41,"oldLines":3,"newStart":41,"newLines":35,"lines":["     from app.services import quellen","     d1 = quellen.demo_inserate(\"p\")","     assert len(d1) == 2 and all(\"Demo\" in x[\"titel\"] for x in d1)","+","+def test_agenten_prompts_und_tools():","+    from app.agents.registry import AGENTEN","+    assert len(AGENTEN) >= 20","+    for a in AGENTEN.values():","+        assert a.systemprompt, a.id","+    assert \"listing.import\" in AGENTEN[\"wohnung\"].tools","+    assert AGENTEN[\"safety\"].tools == []","+    assert AGENTEN[\"coding\"].tools == [\"shell.ausfuehren\", \"docs.suchen\"]","+","+def test_tool_gate():","+    from app.tools.registry import darf_tool","+    ok, _ = darf_tool(\"finance\", \"docs.suchen\", False)","+    assert ok","+    ok, grund = darf_tool(\"finance\", \"mail.senden\", False)","+    assert not ok and \"Freigabe\" in grund","+    ok, _ = darf_tool(\"planner\", \"shell.ausfuehren\", True)","+    assert not ok  # Agent nicht berechtigt, trotz Freigabe","+","+def test_betrag_parser():","+    import importlib.util","+    assert _betrag := True","+    def betrag(roh: str) -> float:","+        s = roh.strip().replace(\" \", \"\")","+        if \",\" in s: s = s.replace(\".\", \"\").replace(\",\", \".\")","+        return float(s)","+    assert betrag(\"1.234,56\") == 1234.56 and betrag(\"1234.56\") == 1234.56","+","+def test_gateway_tool_schema():","+    from app.providers.gateway import tool_schema_fuer","+    s = tool_schema_fuer(\"docs.suchen\", \"Suche\")","+    assert s[\"function\"][\"name\"] == \"docs.suchen\""]}]}]}