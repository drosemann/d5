// {"files":[{"path":"\\\\?\\C:\\Users\\danie\\OneDrive\\github-repos\\Agentenplattform\\apps\\backend\\app\\main.py","hunks":[{"oldStart":307,"oldLines":6,"newStart":307,"newLines":27,"lines":["     db.commit()","     return {\"ok\": status.ok, \"detail\": status.detail}"," ","+# --- Systemstatus: Metriken, Worker, Backup ---","+@app.get(\"/api/v1/system/status\")","+def system_status(db: Session = Depends(get_db), _: str = Depends(aktuell)):","+    import os","+    tasks = db.query(models.Task).all()","+    pro_status: dict[str, int] = {}","+    for t in tasks: pro_status[t.status] = pro_status.get(t.status, 0) + 1","+    provider = [{\"id\": p.id, \"name\": p.display_name, \"aktiv\": p.enabled,","+                 \"secret\": p.has_secret} for p in db.query(models.ModelProvider).all()]","+    hb = \"\"","+    try:","+        with open(\"/tmp/worker_heartbeat.txt\") as f: hb = f.read().strip()","+    except Exception: pass","+    letzter_backup = (db.query(models.Event).filter(models.Event.ref_id == \"backup\")","+                      .order_by(models.Event.created_at.desc()).first())","+    return {\"tasks_pro_status\": pro_status, \"provider\": provider,","+            \"worker_heartbeat\": hb or \"kein Heartbeat\",","+            \"backup\": {\"ziel_konfiguriert\": bool(os.environ.get(\"RESTIC_REPOSITORY\", \"\")),","+                       \"letzter_check\": str(letzter_backup.created_at) if letzter_backup else \"nie\"},","+            \"demo_modus\": settings.demo_mode}","+"," # Optionale OpenAI-Fassade (Standard: aus). Nutzt eigene API-Keys, keine Agentenumgehung."," # Dokumentierte Zuordnung: model \"agent-<agent_id>\" ruft NUR das Modell mit dem"," # Systemprompt dieses Agenten auf – keine Tools, keine Provider-Details, keine Rechte."]}]}]}
