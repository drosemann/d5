{"files":[{"path":"\\\\?\\C:\\Users\\danie\\OneDrive\\github-repos\\Agentenplattform\\apps\\backend\\tests\\test_kern.py","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":24,"lines":["+\"\"\"Kerntests (ohne externe Dienste, Mocks). Betrieb: pytest (mit Freigabe).\"\"\"","+from app.services.orchestrator import statuswechsel_erlaubt, delegierentiefe_pruefen","+from app.services.mail import absender_erlaubt, anhang_geprueft","+from app.tools.registry import darf_tool, ssrf_geprueft","+from app.services.markt import ranking, ist_duplikat","+from app.agents.registry import routing_stichwort","+","+def test_statusmaschine():","+    assert statuswechsel_erlaubt(\"pending\",\"queued\") and not statuswechsel_erlaubt(\"pending\",\"succeeded\")","+def test_delegationstiefe():","+    assert delegierentiefe_pruefen([\"a\",\"b\"]) and not delegierentiefe_pruefen([\"a\",\"b\",\"a\"])","+def test_mail_absender():","+    assert not absender_erlaubt(\"fremd@evil.de\")","+def test_anhang():","+    assert not anhang_geprueft(\"x.exe\", 10)[0] and not anhang_geprueft(\"d.pdf\", 99*1024*1024)[0]","+def test_tool_freigabe():","+    ok,_ = darf_tool(\"finance\",\"mail.senden\",False); assert not ok","+    ok,_ = darf_tool(\"finance\",\"mail.senden\",True); assert ok","+    assert not ssrf_geprueft(\"http://169.254.169.254/x\")","+def test_markt():","+    assert ist_duplikat(\"https://a.de/x?y=1\",\"https://A.DE/x\")","+    assert ranking(500, 1000) > ranking(1500, 1000)","+def test_routing():","+    assert routing_stichwort(\"Finanzbericht importieren\") == \"finance\""]}]}]}