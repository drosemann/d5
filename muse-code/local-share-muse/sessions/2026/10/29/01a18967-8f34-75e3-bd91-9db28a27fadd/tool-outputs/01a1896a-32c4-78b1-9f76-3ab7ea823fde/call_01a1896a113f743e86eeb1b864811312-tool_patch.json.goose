// {"files":[{"path":"\\\\?\\C:\\Users\\danie\\OneDrive\\github-repos\\Agentenplattform\\apps\\backend\\app\\providers\\gateway.py","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":61,"lines":["+\"\"\"Zentrales Modell-Gateway: einzige Stelle für LLM-Aufrufe.\"\"\"","+from __future__ import annotations","+from typing import Protocol","+import httpx","+from pydantic import BaseModel","+","+class ChatNachricht(BaseModel):","+    rolle: str  # system|user|assistant","+    inhalt: str","+","+class ChatAnfrage(BaseModel):","+    nachrichten: list[ChatNachricht]","+    modell: str = \"\"","+    temperatur: float = 0.3","+    max_tokens: int = 800","+    timeout: int = 60","+","+class ChatAntwort(BaseModel):","+    text: str","+    modell: str = \"\"","+    prompt_tokens: int = 0","+    completion_tokens: int = 0","+","+class ProviderStatus(BaseModel):","+    ok: bool; detail: str = \"\"","+","+class ModelProvider(Protocol):","+    async def chat(self, req: ChatAnfrage) -> ChatAntwort: ...","+    async def healthcheck(self) -> ProviderStatus: ...","+","+class OpenAIKompatibelProvider:","+    \"\"\"Spricht Ollama (/v1), OpenAI und kompatible Endpunkte via Chat-Completions.\"\"\"","+    def __init__(self, base_url: str, api_key: str, modell: str, timeout: int = 60):","+        self.base_url, self.api_key, self.modell, self.timeout = base_url.rstrip(\"/\"), api_key, modell, timeout","+    async def chat(self, req: ChatAnfrage) -> ChatAntwort:","+        url = f\"{self.base_url}/chat/completions\"","+        body = {\"model\": req.modell or self.modell,","+                \"messages\": [{\"role\": n.rolle, \"content\": n.inhalt} for n in req.nachrichten],","+                \"temperature\": req.temperatur, \"max_tokens\": req.max_tokens}","+        try:","+            async with httpx.AsyncClient(timeout=req.timeout or self.timeout) as c:","+                r = await c.post(url, json=body, headers={\"Authorization\": f\"Bearer {self.api_key}\"})","+                r.raise_for_status(); d = r.json()","+            msg = d[\"choices\"][0][\"message\"][\"content\"]","+            u = d.get(\"usage\", {})","+            return ChatAntwort(text=msg, modell=d.get(\"model\", \"\"), prompt_tokens=u.get(\"prompt_tokens\", 0), completion_tokens=u.get(\"completion_tokens\", 0))","+        except Exception as e:","+            raise RuntimeError(f\"Providerfehler ({self.base_url}): {e}\") from e","+    async def healthcheck(self) -> ProviderStatus:","+        try:","+            async with httpx.AsyncClient(timeout=10) as c:","+                r = await c.get(f\"{self.base_url}/models\", headers={\"Authorization\": f\"Bearer {self.api_key}\"})","+                return ProviderStatus(ok=r.status_code < 500, detail=f\"HTTP {r.status_code}\")","+        except Exception as e: return ProviderStatus(ok=False, detail=str(e))","+","+class MockProvider:","+    \"\"\"Deterministischer Demo-Provider für Tests/Demo ohne echte Modelle.\"\"\"","+    async def chat(self, req: ChatAnfrage) -> ChatAntwort:","+        letzte = req.nachrichten[-1].inhalt if req.nachrichten else \"\"","+        return ChatAntwort(text=f\"[Demo-Antwort] Eingabe verstanden ({len(letzte)} Zeichen). Echter Provider ist deaktiviert.\", modell=\"mock\")","+    async def healthcheck(self) -> ProviderStatus: return ProviderStatus(ok=True, detail=\"Mock aktiv\")"]}]}]}
