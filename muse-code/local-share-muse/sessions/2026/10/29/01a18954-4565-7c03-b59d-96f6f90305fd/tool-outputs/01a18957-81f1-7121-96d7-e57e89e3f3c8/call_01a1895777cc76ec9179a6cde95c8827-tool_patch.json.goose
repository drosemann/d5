// {"files":[{"path":"\\\\?\\C:\\Users\\danie\\OneDrive\\github-repos\\TraumaLang\\src\\codegen.c","hunks":[{"oldStart":64,"oldLines":6,"newStart":64,"newLines":22,"lines":[" static void collect_uses_list(TlNodeList *l, NameSet *decl, NameSet *imp, int toplevel) {","     for (; l; l = l->next) collect_uses_node(l->node, decl, imp, toplevel);"," }","+static void collect_uses_args(TlNodeList *l, NameSet *decl, NameSet *imp) {","+    for (; l; l = l->next) {","+        TlNode *e = l->node;","+        if (!e) continue;","+        if (e->kind == N_EXPR_VAR) collect_use_name(e->name, decl, imp);","+        else if (e->kind == N_EXPR_BINOP) { collect_uses_expr(e->left, decl, imp); collect_uses_expr(e->right, decl, imp); }","+        else if (e->kind == N_FUNCCALL) {","+            for (TlNodeList *a = e->args; a; a = a->next) {","+                TlNode *ae = a->node;","+                if (ae && ae->kind == N_EXPR_VAR) collect_use_name(ae->name, decl, imp);","+                else collect_uses_expr(ae, decl, imp);","+            }","+        }","+        else collect_uses_expr(e, decl, imp);","+    }","+}"," static void collect_use_name(const char *name, NameSet *decl, NameSet *imp) {","     if (!name || !name[0]) return;","     for (int i = 0; i < decl->n; i++) if (!strcmp(decl->names[i], name)) return;"]}]}]}
