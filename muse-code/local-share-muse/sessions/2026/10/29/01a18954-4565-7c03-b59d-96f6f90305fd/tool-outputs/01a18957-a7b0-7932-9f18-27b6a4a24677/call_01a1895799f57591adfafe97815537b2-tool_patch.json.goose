// {"files":[{"path":"\\\\?\\C:\\Users\\danie\\OneDrive\\github-repos\\TraumaLang\\src\\codegen.c","hunks":[{"oldStart":140,"oldLines":6,"newStart":140,"newLines":62,"lines":[" "," static void indent(FILE *out, int n) { for (int i = 0; i < n; i++) fputs(\"    \", out); }"," ","+/* Scope-Stapel fuer echten Reset: jede Funktion / das Toplevel sammelt alle","+   TlVal-Namen (deklariert + implizit, inkl. Blöcke), N_RESET setzt sie zurueck. */","+static NameSet scope_stack[32];","+static int scope_depth = 0;","+static void scope_push(TlNodeList *body, const TlNode *fn) {","+    if (scope_depth >= 32) return;","+    NameSet *s = &scope_stack[scope_depth++];","+    s->n = 0;","+    NameSet imp; imp.n = 0;","+    NameSet decl; decl.n = 0;","+    /* Params gehoeren zum Scope. */","+    if (fn && fn->kind == N_FUNCDEF)","+        for (int i = 0; i < fn->param_count; i++) set_add(&decl, fn->params[i]);","+    for (TlNodeList *l = body; l; l = l->next)","+        if (l->node->kind == N_VARDECL) set_add(&decl, l->node->name);","+    collect_uses_list(body, &decl, &imp, 1);","+    for (int i = 0; i < decl.n; i++) set_add(s, decl.names[i]);","+    for (int i = 0; i < imp.n; i++) set_add(s, imp.names[i]);","+}","+static void scope_pop(void) { if (scope_depth > 0) scope_depth--; }","+","+/* TlVal-Rueckgabeausdruck bauen: Zielvariable per set/copy fuellen. */","+static int gen_tlval_set(const char *target, TlNode *e, FILE *out, char **err);","+","+/* Call-Argumente als TlVal-Ausdrucksliste: Zahl->Zahl, String->String,","+   Var->Var, Null->Null, Binop->num. Gibt Komma-Separierung aus. */","+static int gen_call_args(TlNodeList *args, FILE *out, char **err) {","+    int first = 1;","+    for (; args; args = args->next) {","+        if (!first) fputs(\", \", out);","+        first = 0;","+        TlNode *e = args->node;","+        if (!e) { *err = \"fehlendes Argument\"; return -1; }","+        switch (e->kind) {","+        case N_EXPR_NUM: fprintf(out, \"(TlVal){.tag=TL_NUM,.num=%ldL,.str=0}\", e->ival); break;","+        case N_EXPR_STR: fputs(\"(TlVal){.tag=TL_STR,.num=0,.str=\", out); {","+            fputc('\"', out);","+            for (const char *p = e->sval ? e->sval : \"\"; *p; p++) {","+                if (*p == '\"' || *p == '\\\\') { fputc('\\\\', out); fputc(*p, out); }","+                else fputc(*p, out);","+            }","+            fputs(\"}\", out);","+            break;","+        }","+        case N_EXPR_VAR: emit_ident(out, e->name); break;","+        case N_EXPR_NULL: fputs(\"(TlVal){.tag=TL_NULL,.num=0,.str=0}\", out); break;","+        case N_COND_PROB: fprintf(out, \"(TlVal){.tag=TL_NUM,.num=tl_prob(%ld),.str=0}\", e->ival); break;","+        default:","+            fputs(\"(TlVal){.tag=TL_NUM,.num=(\", out);","+            if (gen_expr(e, out, err)) return -1;","+            fputs(\"),.str=0}\", out); break;","+        }","+    }","+    return 0;","+}","+"," static int gen_stmt(TlNode *s, FILE *out, int ind, char **err);"," "," static int gen_body(TlNodeList *l, FILE *out, int ind, char **err) {"]}]}]}
