[pytest]
testpaths = tests
markers =
  unit: Unit tests
  integration: Integration tests
  e2e: End-to-end tests using mocked providers
  smoke: Fast import and health checks
  asyncio: Async tests run via pytest-asyncio
addopts = --cov=main --cov=config --cov=db --cov=integration --cov=webhook_server --cov=rbac_store --cov=rate_limiter --cov=secrets_manager --cov=vps_manager --cov=vps_docker_support --cov=vps_instance_persistence --cov=vps_container_lifecycle --cov=vps_backup_snapshots --cov=vps_health_monitoring --cov=rbac --cov=compute --cov=manifest --cov-report=xml:coverage.xml --cov-report=term-missing --cov-fail-under=55


