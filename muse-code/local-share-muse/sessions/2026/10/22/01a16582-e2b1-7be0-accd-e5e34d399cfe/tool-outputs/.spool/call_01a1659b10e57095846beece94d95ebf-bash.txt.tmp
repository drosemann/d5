---DISCORD---
    build:
      context: ./services/discord-service
      dockerfile: Dockerfile
      target: production
    container_name: infra-pilot-discord
    read_only: true
    tmpfs:
      - /tmp
      - /app/tmp
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    # WARNING: direct Docker socket mount = host root equivalent.
    # The :ro suffix only restricts filesystem writes to the socket path;
    # it does NOT filter Docker Engine API requests ƒ?" any holder can mutate the daemon.
    # In production use an allowlisted socket proxy (e.g. tecnativa/docker-socket-proxy)
    # and set DOCKER_HOST to the proxy (e.g. tcp://socket-proxy:2375). This mount
    # is for trusted dev/lab only. Enable only via --profile discord.
    environment:
      DISCORD_TOKEN: ${DISCORD_TOKEN:-}
      PTERODACTYL_API_URL: ${PTERODACTYL_API_URL:-http://localhost:8080/api}
      PTERODACTYL_API_KEY: ${PTERODACTYL_API_KEY:-local-dev-key}
      SERVER_CREATION_CHANNEL_ID: ${SERVER_CREATION_CHANNEL_ID:-}
      LOCATION_ID: ${LOCATION_ID:-1}
      API_BASE_URL: http://management-panel:3001
      DB_HOST: postgres
      DB_PORT: 5432
      DB_USER: ${POSTGRES_USER:-infra_pilot}
      DB_PASSWORD: ${POSTGRES_PASSWORD}
      DB_NAME: ${POSTGRES_DB:-infra_pilot}
      WHITELIST_IDS: ${WHITELIST_IDS:-}
      HEALTH_CHECK_INTERVAL_SECONDS: ${HEALTH_CHECK_INTERVAL_SECONDS:-60}
      DEFAULT_SSH_IMAGE: ${DEFAULT_SSH_IMAGE:-ubuntu:22.04}
      PUBLIC_IP: ${PUBLIC_IP:-127.0.0.1}
      SERVER_LIMIT: ${SERVER_LIMIT:-5}
      CUTTLY_API_KEY: ${CUTTLY_API_KEY:-}
      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD:-}
      BACKUP_RETENTION: '${BACKUP_RETENTION:-{"daily": 7, "weekly": 4, "monthly": 6}}'
      HOST_IP: ${HOST_IP:-127.0.0.1}
      NODE_ENV: ${NODE_ENV:-development}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
    ports:
      - "${DISCORD_WEBHOOK_PORT:-3002}:3000"


