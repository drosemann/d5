---SUBMOD---
---IGNORE---
.env
__pycache__/
*.py[cod]
data/
---DOCKERIGNORE---
.git
.github
data
__pycache__
*.py[cod]
.env

---DEPLOY---
name: CI and deploy

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

permissions:
  contents: read

jobs:
  validate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: Check Python syntax
        run: python -m compileall -q app
      - name: Build container
        run: docker build -t aktienwerk:${{ github.sha }} .

  deploy:
    if: github.event_name == 'push' && github.ref == 'refs/heads/main'
    needs: validate
    runs-on: ubuntu-latest
    steps:
      - name: Configure SSH
        env:
          DEPLOY_KEY: ${{ secrets.DEPLOY_SSH_KEY }}
          KNOWN_HOSTS: ${{ secrets.DEPLOY_KNOWN_HOSTS }}
        run: |
          install -m 700 -d ~/.ssh
          printf '%s\n' "$DEPLOY_KEY" > ~/.ssh/id_ed25519
          chmod 600 ~/.ssh/id_ed25519
          printf '%s\n' "$KNOWN_HOSTS" > ~/.ssh/known_hosts
          chmod 600 ~/.ssh/known_hosts
      - name: Update and restart Aktienwerk on Proxmox
        env:
          DEPLOY_HOST: ${{ secrets.DEPLOY_HOST }}
          DEPLOY_USER: ${{ secrets.DEPLOY_USER }}
          DEPLOY_PATH: ${{ vars.DEPLOY_PATH }}
        run: |
          test -n "$DEPLOY_HOST"
          test -n "$DEPLOY_USER"
          test -n "$DEPLOY_PATH"
          ssh "$DEPLOY_USER@$DEPLOY_HOST" "cd '$DEPLOY_PATH' && git pull --ff-only && docker compose up -d --build"

---UNIVERSE-HEAD---
"""A curated S&P 100 universe; SEC CIKs are resolved from SEC's public mapping."""

SP100 = [
    ("AAPL", "Apple"), ("ABBV", "AbbVie"), ("ABT", "Abbott Laboratories"),
    ("ACN", "Accenture"), ("ADBE", "Adobe"), ("ADI", "Analog Devices"),
    ("ADM", "Archer-Daniels-Midland"), ("ADP", "Automatic Data Processing"),
    ("AMGN", "Amgen"), ("AMT", "American Tower"), ("AMZN", "Amazon"),
    ("AVGO", "Broadcom"), ("AXP", "American Express"), ("BA", "Boeing"),
    ("BAC", "Bank of America"), ("BIIB", "Biogen"), ("BK", "Bank of New York Mellon"),
    ("BKNG", "Booking Holdings"), ("BLK", "BlackRock"), ("BMY", "Bristol Myers Squibb"),
    ("BRK-B", "Berkshire Hathaway"), ("C", "Citigroup"), ("CAT", "Caterpillar"),
    ("CHTR", "Charter Communications"), ("CL", "Colgate-Palmolive"),
    ("CMCSA", "Comcast"), ("COF", "Capital One"), ("COP", "ConocoPhillips"),
    ("COST", "Costco"), ("CRM", "Salesforce"), ("CSCO", "Cisco"),
    ("CVS", "CVS Health"), ("CVX", "Chevron"), ("DE", "Deere"),
---CSS---
:root{color-scheme:dark;--bg:#080a10;--panel:#10131d;--line:#222738;--text:#f1f3f9;--muted:#969db0;--pink:#ed73cd;--green:#55d6a1;--red:#ff777f;--blue:#5776e8}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:15px/1.6 Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}a{color:inherit;text-decoration:none}.topbar{height:76px;display:flex;align-items:center;justify-content:space-between;padding:0 max(calc((100vw - 1160px)/2),6%);border-bottom:1px solid var(--line);background:rgba(8,10,16,.94)}.brand{display:flex;gap:11px;align-items:center;font-size:20px;font-weight:750;letter-spacing:-.8px}.brand img{width:37px;height:37px;object-fit:cover;border-radius:10px}.accent{color:var(--pink)}nav{display:flex;gap:28px;color:#b6bbca;font-size:13px}nav a:hover,.breadcrumb a:hover{color:var(--pink)}main{max-width:1160px;margin:auto;padding:0 28px 80px}.hero{padding:92px 0 56px;max-width:710px}.eyebrow{color:var(--pink);font-size:10px;letter-spacing:2px;font-weight:750}.hero h1{font-size:clamp(46px,8vw,75px);line-height:1.04;letter-spacing:-4px;margin:17px 0 19px}.hero>p{color:var(--muted);font-size:17px;max-width:590px}.search{margin-top:29px;height:54px;max-width:570px;display:flex;align-items:center;gap:14px;background:var(--panel);border:1px solid #303548;border-radius:11px;padding:0 17px}.search span{font-size:23px;color:var(--pink)}.search input{flex:1;color:var(--text);background:transparent;border:0;outline:0;font:inherit}.market-note{margin-top:18px;color:var(--muted);font-size:12px}.market-note i{display:inline-block;background:var(--green);width:7px;height:7px;border-radius:50%;margin-right:8px}.section{margin-top:44px}.section-heading{display:flex;align-items:end;justify-content:space-between;margin-bottom:19px}.section-heading h2{font-size:24px;letter-spacing:-.5px;margin:2px 0 0}.muted{color:var(--muted);font-size:12px}.stock-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.stock-card{min-height:101px;padding:15px;background:var(--panel);border:1px solid var(--line);border-radius:10px;display:grid;grid-template-columns:1fr auto;grid-template-rows:auto auto;gap:3px 8px;transition:border-color .15s,transform .15s}.stock-card:hover{border-color:#656b86;transform:translateY(-2px)}.ticker{font-weight:750;font-size:14px}.company{font-size:11px;color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.quote{grid-column:2;grid-row:1/3;text-align:right;align-self:center;font-weight:650;font-size:14px}.quote small{display:block;font-size:10px;margin-top:3px}.positive{color:var(--green)}.negative{color:var(--red)}.event-list{display:grid;gap:11px}.event-card{display:flex;justify-content:space-between;gap:22px;background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:19px 20px}.event-ticker{font-size:11px;color:var(--pink);font-weight:700}.event-card h3{font-size:16px;margin:6px 0 4px}.event-card p{font-size:13px;color:#b5bbca;margin:0;max-width:820px}.event-card time{display:block;font-size:10px;color:var(--muted);margin-top:10px}.source{align-self:center;white-space:nowrap;font-size:11px;color:#bcc5ef}.loading,.empty{padding:24px;color:var(--muted);background:var(--panel);border-radius:10px}.company-hero{margin-top:48px;padding:34px 0 38px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:24px}.company-hero h1{font-size:44px;letter-spacing:-1.8px;margin:8px 0 0}.symbol{color:var(--muted)}.price-box{min-width:245px;padding:18px 21px;border:1px solid var(--line);border-radius:12px;background:var(--panel);display:flex;flex-direction:column;gap:5px}.price-box strong{font-size:29px}.breadcrumb{margin-top:26px;display:flex;gap:11px;color:var(--muted);font-size:12px}.filing-list{padding-left:20px;color:#dce0e9}.filing-list li{padding:8px 0}.filing-list a:hover{color:var(--pink)}.disclaimer{margin-top:40px;padding:16px;border-left:2px solid var(--pink);background:var(--panel);color:var(--muted);font-size:12px}.not-found{padding:90px 30px}footer{border-top:1px solid var(--line);padding:24px max(calc((100vw - 1160px)/2),6%);display:flex;justify-content:space-between;gap:15px;color:var(--muted);font-size:11px}@media(max-width:850px){.stock-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.topbar{padding:0 24px}main{padding-left:24px;padding-right:24px}footer{padding-left:24px;padding-right:24px;flex-wrap:wrap}}@media(max-width:600px){.topbar{height:65px}nav{gap:13px;font-size:11px}nav a:nth-child(2){display:none}.brand{font-size:17px}.hero{padding-top:66px}.hero h1{letter-spacing:-2.8px}.stock-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.stock-card{padding:12px;min-height:88px}.section{margin-top:34px}.company-hero{align-items:flex-start;flex-direction:column}.company-hero h1{font-size:37px}.price-box{width:100%}.event-card{padding:15px;gap:12px}.source{font-size:10px}footer{flex-direction:column}}

---INIT---
"""Aktienwerk application package."""

