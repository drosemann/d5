fter a fixed number of tool batches.\n\nRequest id: runtime-tool-call:workflow-script-code-run-workflow-run-model-tool-call_01a1b7c610df7134a294d7c0e84a6431:agent-5. Payload ref: workflow-host-call-payload:workflow-script-code-run-workflow-run-model-tool-call_01a1b7c610df7134a294d7c0e84a6431-4dd5c1e8-8d10-45ba-aeb4-fe015c286d09:agent-5.","turnId":"2ad9ba50-be9a-7661-819b-d8425c44c4b5"}},"view_materialization":{"current_state":{"activeTurn":null,"approvalMode":null,"branch":null,"goal":null,"items":{},"lastTurn":{"terminal":"completed","turnId":"2ad9ba50-be9a-7661-819b-d8425c44c4b5"},"model":null,"pendingRequests":{"approvals":{},"userInputs":{}},"queuedTurns":[],"resumeFactsComplete":true,"todoList":null,"tokenUsage":{"cumulative":{"cacheReadTokens":26737,"outputTokens":1299,"promptTokens":58514,"totalTokens":59813},"durationMs":7501,"finishReason":"tool_calls","modelId":"muse-spark-1.3","promptTokens":31673,"sessionId":"91643729-6e9a-7661-858f-b17f74207c19","sourceRange":{"first":{"id":"01a1b7c7-c033-7992-9930-7b71cbe90823","sequence":65},"last":{"id":"01a1b7c7-c033-7992-9930-7b71cbe90823","sequence":65},"stream":{"id":"91643729-6e9a-7661-858f-b17f74207c19","kind":"session"}},"totalTokens":32707,"turnId":"2ad9ba50-be9a-7661-819b-d8425c44c4b5","usage":{"cacheReadTokens":26737,"cacheWriteTokens":0,"cachedTokens":26737,"inputTokens":31673,"outputTokens":1034,"reasoningTokens":62},"viewCursor":"v4:91643729-6e9a-7661-858f-b17f74207c19:7"},"turnCount":1,"viewCursor":"v4:91643729-6e9a-7661-858f-b17f74207c19:10"},"user_input_settlements":{"genesis_authoritative":true,"settled":{}}}},"head_view_ordinal":10,"index_tail":{"byte_length":640,"entry_count":10,"entry_sha256":[162,48,118,11,174,143,172,193,201,46,62,236,252,90,64,92,153,42,211,118,220,121,108,84,150,69,82,249,10,101,213,142]},"journal_tail":{"batch_sha256":[164,128,98,74,134,160,100,92,248,182,248,233,151,165,116,47,240,23,15,240,47,182,72,45,156,195,177,183,70,229,82,141],"byte_length":64046},"limits_version":1,"