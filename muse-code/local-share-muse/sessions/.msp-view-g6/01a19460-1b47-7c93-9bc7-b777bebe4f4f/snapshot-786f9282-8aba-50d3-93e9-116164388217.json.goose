milestone 2 weeks ago\n@drosemann\ndrosemann\ncommented\n2 weeks ago\nOwner\nAuthor\nPR wird am 31.10 gemergt. Ab dann haben wir feste Releases.\n\n@drosemann\ndrosemann\ncommented\n1 minute ago\nOwner\nAuthor\nDatum um ~1h verfehlt, wird jetzt gemergt.\n\nMerge info\nSome checks were not successful\n1 failing, 19 skipped, 7 successful checks\n\n\nMerging is blocked\nCode scanning is still expecting 1 result from CodeQL for 8367908 or 24fb890.\nYou can also merge this with the command line. \nStill in progress?\n@drosemann\n\n\nAdd a comment","turnId":"01a19460-970a-7102-89ac-36d0629f42a0"}},"view_materialization":{"current_state":{"activeTurn":null,"approvalMode":null,"branch":{"branch":"main","sessionId":"01a19460-1b47-7c93-9bc7-b777bebe4f4f","sourceRange":{"first":{"id":"01a19463-4392-7391-93dd-22bcc3440c14","sequence":1577},"last":{"id":"01a19463-4392-7391-93dd-22bcc3440c14","sequence":1577},"stream":{"id":"01a19460-1b47-7c93-9bc7-b777bebe4f4f","kind":"session"}},"vcs":"git","viewCursor":"v4:01a19460-1b47-7c93-9bc7-b777bebe4f4f:188","workspaceRoot":"C:\\Users\\danie\\OneDrive\\github-repos\\infra-pilot"},"goal":null,"items":{},"lastTurn":{"terminal":"completed","turnId":"01a19460-970a-7102-89ac-36d0629f42a0"},"model":null,"pendingRequests":{"approvals":{},"userInputs":{}},"queuedTurns":[],"resumeFactsComplete":true,"todoList":null,"tokenUsage":{"cumulative":{"cacheReadTokens":938500,"outputTokens":4900,"promptTokens":996766,"totalTokens":1001666},"durationMs":4913,"modelId":"muse-wonder-1.0","promptTokens":57020,"sessionId":"01a19460-1b47-7c93-9bc7-b777bebe4f4f","sourceRange":{"first":{"id":"01a19463-15c3-74c1-9132-2b8658d4321f","sequence":1547},"last":{"id":"01a19463-15c3-74c1-9132-2b8658d4321f","sequence":1547},"stream":{"id":"01a19460-1b47-7c93-9bc7-b777bebe4f4f","kind":"session"}},"totalTokens":57490,"turnId":"01a19460-970a-7102-89ac-36d0629f42a0","usage":{"cacheReadTokens":55924,"cacheWriteTokens":0,"cachedTokens":55924,"inputTokens":57020,"outputTokens":47