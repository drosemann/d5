# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY=your_access_key
AWS_SECRET_KEY=your_secret_key
ECS_CLUSTER=your_cluster_arn
ECS_TASK_ARN=your_task_arn

# Redis Configuration
REDIS_URL=your_redis_url

# Server Configuration
API_PORT=9000
SOCKET_PORT=9002
PROXY_PORT=8000

# S3 Configuration
S3_BUCKET=vercel-clone-outputs

# Build Configuration
BUILD_TIMEOUT=300
MAX_BUILD_CONCURRENT=5
