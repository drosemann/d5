# Replace with a real contact address as required by SEC fair-access guidelines.
SEC_USER_AGENT=Aktienwerk/1.0 kontakt@example.com

# Optional local Ollama service reachable by the web and worker containers.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1

# Optional: enables earnings-call transcript imports via Financial Modeling Prep.
FMP_API_KEY=

AKTIENWERK_PORT=8080
SITE_URL=https://aktienwerk.example.com
POLL_INTERVAL_SECONDS=3600
